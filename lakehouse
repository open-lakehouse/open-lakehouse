#!/bin/bash

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

# Load environment variables. When an explicit LAKEHOUSE_ENV_FILE is set (test
# overlay / fixtures, plan 1.16.1) it REPLACES .env, so production .env values do
# not leak into an overlay-scoped run; otherwise the default .env is used.
if [ -n "${LAKEHOUSE_ENV_FILE:-}" ]; then
    if [ -f "$LAKEHOUSE_ENV_FILE" ]; then
        set -a
        # shellcheck disable=SC1090  # path is user-provided by design (test overlay)
        source "$LAKEHOUSE_ENV_FILE"
        set +a
    fi
elif [ -f "$PROJECT_ROOT/.env" ]; then
    set -a
    source "$PROJECT_ROOT/.env"
    set +a
fi

# Test-only overlay resolution + destructive-target validation. Sourced always;
# a complete no-op unless the LAKEHOUSE_* overlay variables are set (plan 1.16.1).
# Keeps compose files, container names, and published ports resolvable from one place.
OVERLAY_ACTIVE=false
# shellcheck source=scripts/lib/overlay.sh
source "$PROJECT_ROOT/scripts/lib/overlay.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check for GNU tools, when on MacOS
# See also https://github.com/cloud-helpers/k8s-job-wrappers/tree/main/setGnuTools.sh
export DF_TOOL="df"
check_gnutools_on_macos() {
	DF_TOOL="gdf"
	if ! command -v "$DF_TOOL" >/dev/null 2>&1
	then
        echo -e "${RED}Missing GNU tools on MacOS:${NC}"
        echo -e "  ${RED}✗${NC} $DF_TOOL"
		return 1
	fi
}

# Check if a command exists
check_cmd() {
    command -v "$1" >/dev/null 2>&1
}

# Browse Iceberg data
browse_tables() {
    local table="${1:-iceberg.bronze.orders}"
    local master
    master=$(resolve_container_name "$(get_spark_master_container)")
    docker exec -it "$master" sh -c "/opt/spark/bin/spark-sql -e \"select * from ${table} limit 10;\""
}

# Setup PostgreSQL database (create if not exists)
setup_postgres() {
    local pg_user="${POSTGRES_USER:-postgres}"
    local pg_pass="${POSTGRES_PASSWORD:-}"
    local pg_host="${POSTGRES_HOST:-localhost}"
    pg_host="${pg_host/host.docker.internal/localhost}"
    local pg_port="${POSTGRES_PORT:-5432}"
    local db_name="iceberg_catalog"

    echo -e "${YELLOW}Checking PostgreSQL database...${NC}"

    # Check if PostgreSQL is reachable
    if ! nc -z "$pg_host" "$pg_port" 2>/dev/null; then
        echo -e "   ${RED}✗${NC} PostgreSQL not reachable on $pg_host:$pg_port"
        echo -e "   ${YELLOW}→ Ensure PostgreSQL is running${NC}"
        return 1
    fi

    # Check if psql is available
    if ! check_cmd psql; then
        echo -e "   ${YELLOW}!${NC} psql not installed - cannot auto-create database"
        echo -e "   ${YELLOW}→ Manually create database: createdb $db_name${NC}"
        return 0
    fi

    # Check if database exists
    if PGPASSWORD="$pg_pass" psql -h "$pg_host" -p "$pg_port" -U "$pg_user" -d "$db_name" -c "SELECT 1;" >/dev/null 2>&1; then
        echo -e "   ${GREEN}✓${NC} Database '$db_name' exists"
        return 0
    fi

    # Database doesn't exist - attempt to create it
    echo -e "   ${YELLOW}!${NC} Database '$db_name' not found"

    # Try to connect to postgres default database to create iceberg_catalog
    if PGPASSWORD="$pg_pass" psql -h "$pg_host" -p "$pg_port" -U "$pg_user" -d postgres -c "CREATE DATABASE $db_name;" 2>/dev/null; then
        echo -e "   ${GREEN}✓${NC} Created database '$db_name'"
        return 0
    else
        echo -e "   ${RED}✗${NC} Failed to create database '$db_name'"
        echo -e "   ${YELLOW}→ Create manually: createdb -h $pg_host -U $pg_user $db_name${NC}"
        return 1
    fi
}

# Validate credential consistency between .env and spark-defaults.conf
# UC-only mode: catalog auth lives in Unity Catalog server.properties.
# Spark-side config only needs to point at the UC REST endpoint and hold S3 creds.
check_credential_consistency() {
    local has_issues=0
    local spark_conf="$PROJECT_ROOT/config/spark/spark-defaults.conf"

    if [ ! -f "$spark_conf" ]; then
        echo -e "   ${RED}✗${NC} spark-defaults.conf not found"
        return 1
    fi

    local spark_s3_key=$(grep 'spark.hadoop.fs.s3a.access.key' "$spark_conf" 2>/dev/null | awk '{print $2}')
    local spark_uc_uri=$(grep 'spark.sql.catalog.iceberg.uri' "$spark_conf" 2>/dev/null | awk '{print $2}')

    if [ "$spark_s3_key" = "your_access_key" ]; then
        echo -e "   ${YELLOW}!${NC} spark-defaults.conf has placeholder S3 access key"
        has_issues=1
    fi
    if [ -z "$spark_uc_uri" ]; then
        echo -e "   ${YELLOW}!${NC} spark.sql.catalog.iceberg.uri not set (Unity Catalog REST endpoint missing)"
        has_issues=1
    fi

    if [ -f "$PROJECT_ROOT/.env" ]; then
        source "$PROJECT_ROOT/.env"
        if [ -n "$S3_ACCESS_KEY" ] && [ -n "$spark_s3_key" ] && [ "$S3_ACCESS_KEY" != "$spark_s3_key" ]; then
            echo -e "   ${YELLOW}!${NC} S3 access key mismatch between .env and spark-defaults.conf"
            has_issues=1
        fi
    fi

    if [ $has_issues -eq 0 ]; then
        echo -e "   ${GREEN}✓${NC} Credentials consistent"
    fi

    return $has_issues
}

# Preflight checks before starting services
preflight_checks() {
    local check_postgres=${1:-true}
    local check_seaweedfs=${2:-true}
    local check_ports=${3:-true}
    local has_errors=0

    echo -e "\n${YELLOW}Running preflight checks...${NC}"

    # Check PostgreSQL. Storage is now a Compose service that `start storage`
    # bootstraps, so a COLD preflight must NOT demand it already be up (Bugbot
    # #157) — "not running yet" is a hint, not an error. When it IS up, probe it
    # via pg_psql (host client if present, else a version-matched dockerized
    # client — never a bare host `psql`, Bugbot #164). Only probe deeper when the
    # port is actually listening, so a cold preflight never pulls a client image.
    if [ "$check_postgres" = true ]; then
        local pg_port="${POSTGRES_PORT:-5432}"
        if ! nc -z localhost "$pg_port" 2>/dev/null; then
            echo -e "   ${YELLOW}-${NC} PostgreSQL not running yet (OK for a cold preflight)"
            echo -e "   ${YELLOW}→ It will be started by: ./lakehouse start storage (or start all)${NC}"
        elif pg_psql -d iceberg_catalog -c "SELECT 1;" >/dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} PostgreSQL connection OK"
        else
            echo -e "   ${YELLOW}!${NC} PostgreSQL is listening on $pg_port but the auth/db check failed"
            echo -e "   ${YELLOW}→ Check POSTGRES_USER/PASSWORD in .env; iceberg_catalog is created by 'start storage'${NC}"
        fi
    fi

    # Check SeaweedFS S3 endpoint. Same cold-preflight rule as PostgreSQL: absent
    # is a hint, not a blocker (Bugbot #157).
    if [ "$check_seaweedfs" = true ]; then
        local s3_endpoint="${S3_ENDPOINT:-http://localhost:8333}"
        s3_endpoint="${s3_endpoint/host.docker.internal/localhost}"

        if curl -s --connect-timeout 5 "$s3_endpoint" > /dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} SeaweedFS S3 endpoint OK"
        else
            echo -e "   ${YELLOW}-${NC} SeaweedFS S3 endpoint not running yet (OK for a cold preflight)"
            echo -e "   ${YELLOW}→ It will be started by: ./lakehouse start storage (or start all)${NC}"
        fi
    fi

    # Check required ports are free
    if [ "$check_ports" = true ]; then
        local spark_port=$(get_spark_port)
        local spark_ui_port=$(get_spark_ui_port)
        local ports_to_check=("$spark_port:Spark Master" "$spark_ui_port:Spark UI" "9092:Kafka" "2181:Zookeeper")

        for port_info in "${ports_to_check[@]}"; do
            local port="${port_info%%:*}"
            local name="${port_info#*:}"
            if nc -z localhost "$port" 2>/dev/null; then
                # Port in use - check if it's our expected service
                case $port in
                    "$spark_port"|"$spark_ui_port")
                        if docker ps --format '{{.Names}}' | grep -q "spark-master"; then
                            echo -e "   ${GREEN}✓${NC} Port $port ($name) - existing Spark service"
                        else
                            echo -e "   ${YELLOW}!${NC} Port $port ($name) already in use"
                        fi
                        ;;
                    9092)
                        if docker ps --format '{{.Names}}' | grep -q "^$(resolve_container_name kafka)$"; then
                            echo -e "   ${GREEN}✓${NC} Port $port ($name) - existing Kafka service"
                        else
                            echo -e "   ${YELLOW}!${NC} Port $port ($name) already in use"
                        fi
                        ;;
                    *)
                        echo -e "   ${YELLOW}!${NC} Port $port ($name) already in use"
                        ;;
                esac
            else
                echo -e "   ${GREEN}✓${NC} Port $port ($name) available"
            fi
        done
    fi

    return $has_errors
}

# Check prerequisites and return missing ones
check_prerequisites() {
    local missing=()
    local warnings=()

    # Required commands
    check_cmd docker || missing+=("docker")
    check_cmd poetry || missing+=("poetry")
    check_cmd curl || missing+=("curl")

    # Check docker compose (v2 plugin)
    if check_cmd docker; then
        docker compose version >/dev/null 2>&1 || missing+=("docker-compose-plugin")
    fi

    # Optional but recommended
    check_cmd nc || warnings+=("nc (netcat) - needed for port checks")
    check_cmd psql || warnings+=("psql - needed for PostgreSQL tests")

    # Check Java version for Spark
    if check_cmd java; then
        local java_version=$(java -version 2>&1 | head -1 | cut -d'"' -f2 | cut -d'.' -f1)
        if [ "$java_version" -lt 17 ] 2>/dev/null; then
            warnings+=("Java 17+ recommended (found Java $java_version)")
        fi
    else
        warnings+=("java - needed for local spark-submit")
    fi

    # Check Python version
    if check_cmd python3; then
        local py_version=$(python3 -c 'import sys; print(sys.version_info.minor)')
        if [ "$py_version" -lt 10 ] 2>/dev/null; then
            warnings+=("Python 3.10+ recommended")
        fi
    fi

    # Report results
    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}Missing required tools:${NC}"
        for tool in "${missing[@]}"; do
            echo -e "  ${RED}✗${NC} $tool"
        done
        return 1
    fi

    if [ ${#warnings[@]} -gt 0 ]; then
        echo -e "${YELLOW}Warnings:${NC}"
        for warn in "${warnings[@]}"; do
            echo -e "  ${YELLOW}!${NC} $warn"
        done
    fi

    return 0
}

# Wait for a service to be ready
# Security: Uses bash -c with hardcoded commands only (never user input)
wait_for_service() {
    local name=$1
    local check_cmd=$2
    local max_attempts=${3:-30}
    local attempt=1

    # Security: Validate check_cmd only contains safe patterns
    # Only allow: nc, curl, docker, psql commands with safe arguments
    if [[ ! "$check_cmd" =~ ^(nc\ -z|curl\ -s|docker\ exec|PGPASSWORD=) ]]; then
        echo -e "   ${RED}✗${NC} Invalid check command for $name"
        return 1
    fi

    while [ $attempt -le $max_attempts ]; do
        if bash -c "$check_cmd" >/dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} $name ready"
            return 0
        fi
        printf "   Waiting for $name... (%d/%d)\r" $attempt $max_attempts
        sleep 1
        ((attempt++))
    done
    echo -e "   ${RED}✗${NC} $name failed to start (timeout after ${max_attempts}s)"
    return 1
}

# Wait for all services to be healthy
wait_for_services() {
    # Container names resolve through the overlay layer (docker ps sees the
    # suffixed names); localhost health ports stay fixed here — see cmd_status_json.
    local spark_port=$(get_spark_port)
    local master_container=$(resolve_container_name "$(get_spark_master_container)")
    local kafka_ct zk_ct
    kafka_ct=$(resolve_container_name kafka)
    zk_ct=$(resolve_container_name zookeeper)
    echo ""

    # Kafka/Zookeeper (if started)
    if docker ps --format '{{.Names}}' | grep -q "^${zk_ct}$"; then
        wait_for_service "Zookeeper" "nc -z localhost 2181" 30
    fi
    if docker ps --format '{{.Names}}' | grep -q "^${kafka_ct}$"; then
        wait_for_service "Kafka" "nc -z localhost 9092" 30
    fi

    # Spark (if started)
    if docker ps --format '{{.Names}}' | grep -q "^${master_container}$"; then
        wait_for_service "Spark Master" "nc -z localhost $spark_port" 30
        wait_for_service "Spark UI" "curl -s http://localhost:$(get_spark_ui_port) >/dev/null" 30
    fi
}

# Storage (PostgreSQL + SeaweedFS) is deliberately UNSCOPED — one shared instance
# on fixed host ports with FIXED container names: docker-compose-storage.yml uses
# `container_name: postgres` / `seaweedfs`, `overlay_set_compose_args storage` uses
# the base file only, and init-storage.sh defaults POSTGRES_CONTAINER=postgres. Its
# container names must therefore NOT pass through resolve_container_name — under an
# active overlay that would append the run suffix (`postgres-<runid>`) and point
# docker exec/logs/ps at a container that is never created, breaking `start storage`
# / `start all` / `start mlflow` / `start airflow`.
get_storage_postgres_container()  { echo "postgres"; }
get_storage_seaweedfs_container() { echo "seaweedfs"; }

# Wait until the Composed PostgreSQL is actually accepting connections — health,
# not merely an open TCP port (`nc -z` passes before the server is ready). Probes
# pg_isready INSIDE the postgres container, so no host psql client is needed.
#
# Each service is its own compose file and `postgres` lives only in
# docker-compose-storage.yml, so a cross-file `depends_on: postgres` would make a
# plain `docker compose -f docker-compose-mlflow.yml up` fail with "undefined
# service postgres". This CLI-side gate gives the same "don't start until Postgres
# is healthy" guarantee while keeping every compose file independently runnable.
# Returns non-zero if the postgres container isn't running or never becomes ready.
wait_for_postgres_ready() {
    local max_attempts=${1:-60}
    local ctr
    ctr=$(get_storage_postgres_container)
    if ! is_container_running "$ctr"; then
        echo -e "   ${RED}✗${NC} PostgreSQL container ($ctr) is not running"
        echo -e "   ${YELLOW}→ Start storage first: ./lakehouse start storage (or ./lakehouse start all)${NC}"
        return 1
    fi
    local attempt=1
    while [ $attempt -le "$max_attempts" ]; do
        if docker exec "$ctr" pg_isready -U "${POSTGRES_USER:-postgres}" -d postgres >/dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} PostgreSQL ready"
            return 0
        fi
        printf "   Waiting for PostgreSQL... (%d/%d)\r" "$attempt" "$max_attempts"
        sleep 1
        ((attempt++))
    done
    echo -e "   ${RED}✗${NC} PostgreSQL did not become ready (timeout after ${max_attempts}s)"
    return 1
}

# Fixed Spark 4.1 constants (this repo is Spark-4.1-only).
# shellcheck disable=SC2034  # documentary constant; get_spark_* below are the interface
SPARK_VERSION="4.1"
get_spark_compose()           { echo "docker-compose-spark41.yml"; }
get_spark_master_container()  { echo "spark-master-41"; }
get_spark_worker_container()  { echo "spark-worker-41"; }
get_spark_connect_container() { echo "spark-connect-41"; }
get_spark_port()              { echo "7078"; }
get_spark_ui_port()           { echo "8082"; }
get_spark_connect_port()      { echo "15002"; }
get_spark_remote()            { echo "sc://localhost:$(get_spark_connect_port)"; }

# Global flags
JSON_OUTPUT=false
SPARK_MODE="connect"   # connect (default) | local (not yet implemented)
ARGS=()                # positional args after flag-stripping

parse_flags() {
    ARGS=()
    while [[ $# -gt 0 ]]; do
        case $1 in
            --json)          JSON_OUTPUT=true; shift ;;
            --spark-connect) SPARK_MODE="connect"; shift ;;
            --spark-local)   SPARK_MODE="local"; shift ;;
            *)               ARGS+=("$1"); shift ;;
        esac
    done
}

# Refuse local mode for now — placeholder for future in-process Spark
require_connect_mode() {
    if [ "$SPARK_MODE" = "local" ]; then
        echo -e "${YELLOW}!${NC} --spark-local is not yet implemented in this build."
        echo -e "  Connect-first architecture is the default. Re-run without --spark-local."
        echo -e "  Local mode (in-process Spark, no Docker) is on the roadmap; see demos/local-mode-spark/README.md"
        exit 2
    fi
}

# Export Spark transport hints for downstream tooling / demos
export_spark_env() {
    export LAKEHOUSE_SPARK_MODE="$SPARK_MODE"
    if [ "$SPARK_MODE" = "connect" ]; then
        export LAKEHOUSE_SPARK_REMOTE="$(get_spark_remote)"
    fi
}

# Header
header() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}================================${NC}"
}

# Check service status
check_service() {
    local service=$1
    local port=$2
    local name=$3

    if nc -z localhost $port 2>/dev/null; then
        echo -e "${GREEN}✓${NC} $name (port $port)"
        return 0
    else
        echo -e "${RED}✗${NC} $name (port $port)"
        return 1
    fi
}

# Check container
check_container() {
    local container=$1
    if docker ps --format '{{.Names}}' | grep -q "^${container}$"; then
        echo -e "${GREEN}✓${NC} $container"
        return 0
    else
        echo -e "${RED}✗${NC} $container"
        return 1
    fi
}

# Check if service is healthy (silent, returns 0/1)
is_service_healthy() {
    local port=$1
    nc -z localhost "$port" 2>/dev/null
}

# Check Airflow health via API
is_airflow_healthy() {
    curl -s --connect-timeout 2 http://localhost:8085/health 2>/dev/null | grep -q '"healthy"'
}

# Check if container is running (silent, returns 0/1)
is_container_running() {
    local container=$1
    docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${container}$"
}

# Status command - JSON output
cmd_status_json() {
    # Container names resolve through the overlay layer — identical to the base
    # literals on the default path except the allow-listed mlflow->mlflow-server fix
    # (T-1.5.11), and run-scoped when a test overlay is active (docker ps sees the
    # suffixed names). PostgreSQL and SeaweedFS are now Compose services
    # (docker-compose-storage.yml, PR #13/T-1.2) publishing 5432/8333 to the host.
    # Storage has NO test overlay, so it always publishes the fixed ports and is
    # never port-offset — probe them directly (matches `__resolve`, which hardcodes
    # them). Using resolve_port here would wrongly offset under an active overlay.
    local pg_ok=$(is_service_healthy 5432 && echo "true" || echo "false")
    local s3_ok=$(is_service_healthy 8333 && echo "true" || echo "false")
    local spark_master=$(is_container_running "$(resolve_container_name spark-master-41)" && echo "true" || echo "false")
    local spark_worker=$(is_container_running "$(resolve_container_name spark-worker-41)" && echo "true" || echo "false")
    local spark_connect=$(is_container_running "$(resolve_container_name spark-connect-41)" && echo "true" || echo "false")
    local connect_grpc=$(is_service_healthy "$(get_spark_connect_port)" && echo "true" || echo "false")
    local kafka_ok=$(is_container_running "$(resolve_container_name kafka)" && echo "true" || echo "false")
    local zk_ok=$(is_container_running "$(resolve_container_name zookeeper)" && echo "true" || echo "false")
    local uc_ok=$(is_container_running "$(resolve_container_name unity-catalog)" && echo "true" || echo "false")
    local airflow_web=$(is_container_running "$(resolve_container_name airflow-webserver)" && echo "true" || echo "false")
    local airflow_sched=$(is_container_running "$(resolve_container_name airflow-scheduler)" && echo "true" || echo "false")
    local mlflow_ok=$(is_container_running "$(resolve_container_name mlflow)" && echo "true" || echo "false")

    cat <<EOF
{
  "mode": "$SPARK_MODE",
  "services": {
    "postgresql": $pg_ok,
    "seaweedfs": $s3_ok,
    "unity_catalog": $uc_ok,
    "mlflow": $mlflow_ok
  },
  "spark": {
    "version": "4.1",
    "master": $spark_master,
    "worker": $spark_worker,
    "connect_container": $spark_connect,
    "connect_grpc_listening": $connect_grpc,
    "remote": "$(get_spark_remote)"
  },
  "kafka": {
    "broker": $kafka_ok,
    "zookeeper": $zk_ok
  },
  "airflow": {
    "webserver": $airflow_web,
    "scheduler": $airflow_sched
  },
  "all_healthy": $([ "$pg_ok" = "true" ] && [ "$s3_ok" = "true" ] && [ "$spark_master" = "true" ] && [ "$connect_grpc" = "true" ] && echo "true" || echo "false")
}
EOF
}

# Status command - human-readable output
cmd_status_human() {
    header "LAKEHOUSE STATUS"

    local uc_ct spark_master_ct spark_worker_ct spark_connect_ct kafka_ct zk_ct
    local airflow_web_ct airflow_sched_ct airflow_trig_ct mlflow_ct
    uc_ct=$(resolve_container_name unity-catalog)
    spark_master_ct=$(resolve_container_name spark-master-41)
    spark_worker_ct=$(resolve_container_name spark-worker-41)
    spark_connect_ct=$(resolve_container_name spark-connect-41)
    kafka_ct=$(resolve_container_name kafka)
    zk_ct=$(resolve_container_name zookeeper)
    airflow_web_ct=$(resolve_container_name airflow-webserver)
    airflow_sched_ct=$(resolve_container_name airflow-scheduler)
    airflow_trig_ct=$(resolve_container_name airflow-triggerer)
    mlflow_ct=$(resolve_container_name mlflow)

    echo -e "\n${YELLOW}Storage (SeaweedFS + PostgreSQL):${NC}"
    check_container "$(get_storage_postgres_container)" || true
    check_service postgres "5432" "PostgreSQL"
    check_container "$(get_storage_seaweedfs_container)" || true
    check_service seaweedfs "8333" "SeaweedFS S3"

    echo -e "\n${YELLOW}Unity Catalog:${NC}"
    check_container "$uc_ct" && check_service uc 8081 "Unity Catalog REST API" || true

    echo -e "\n${YELLOW}Spark 4.1 (Connect-first):${NC}"
    check_container "$spark_master_ct" && docker exec "$spark_master_ct" /opt/spark/bin/spark-submit --version 2>&1 | grep "version" | head -1 || true
    check_container "$spark_worker_ct" || true
    check_container "$spark_connect_ct" && check_service connect "$(get_spark_connect_port)" "Spark Connect gRPC" || true
    echo -e "  Spark Connect endpoint: ${BLUE}$(get_spark_remote)${NC}"

    echo -e "\n${YELLOW}Kafka Containers:${NC}"
    check_container "$kafka_ct" || true
    check_container "$zk_ct" || true

    echo -e "\n${YELLOW}Airflow Containers:${NC}"
    check_container "$airflow_web_ct" && check_service airflow 8085 "Airflow UI" || true
    check_container "$airflow_sched_ct" || true
    check_container "$airflow_trig_ct" || true

    echo -e "\n${YELLOW}MLflow:${NC}"
    check_container "$mlflow_ct" && check_service mlflow 5000 "MLflow Tracking" || true

    echo -e "\n${YELLOW}Ports:${NC}"
    echo "  PostgreSQL:       5432"
    echo "  SeaweedFS:        8333"
    echo "  Unity Catalog:    8081 (REST API + Iceberg endpoint)"
    echo "  Spark 4.1:        7078, 8082 (UI), 8083 (Worker UI)"
    echo "  Spark Connect:    15002 (gRPC)"
    echo "  Kafka:            9092"
    echo "  Zookeeper:        2181"
    echo "  Airflow:          8085 (UI)"
    echo "  MLflow:           5000 (Tracking), 5001 (AI Gateway)"

    echo -e "\n${YELLOW}Configurations:${NC}"
    echo "  Storage:         docker-compose-storage.yml"
    echo "  Spark:           docker-compose-spark41.yml"
    echo "  Kafka:           docker-compose-kafka.yml"
    echo "  Unity Catalog:   docker-compose-unity-catalog.yml"
    echo "  Airflow:         docker-compose-airflow.yml"
    echo "  MLflow:          docker-compose-mlflow.yml"
    echo "  Spark conf:      config/spark/spark-defaults.conf"
}

# Status command dispatcher
cmd_status() {
    if [ "$JSON_OUTPUT" = true ]; then
        cmd_status_json
    else
        cmd_status_human
    fi
}

# Check if port is available or used by expected container
# Returns: 0 = available or used by expected service, 1 = blocked by something else
check_port_available() {
    local port=$1
    local expected_container=$2

    if ! nc -z localhost "$port" 2>/dev/null; then
        # Port is free
        return 0
    fi

    # Port is in use - check if it's our expected container
    if [ -n "$expected_container" ]; then
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${expected_container}$"; then
            # Our container is using it - that's fine
            return 0
        fi
    fi

    # Port is blocked by something else
    return 1
}

# Pre-start port checks for a service
check_ports_for_service() {
    local service=$1
    local has_conflicts=0

    # Under an active test overlay the stack runs on a project-scoped bridge
    # network and publishes NO host ports (plan 1.17.1) — so host-port conflicts
    # with the production stack cannot occur, and checking the base host ports
    # here would spuriously block startup (the production service legitimately
    # holds them). Skip the host-port pre-flight in overlay mode.
    if [ "${OVERLAY_ACTIVE:-false}" = "true" ]; then
        echo -e "${YELLOW}Overlay active — skipping host-port pre-flight (bridge network, no published ports).${NC}"
        return 0
    fi

    local spark_port=$(get_spark_port)
    local spark_ui_port=$(get_spark_ui_port)
    local master_container worker_container
    master_container=$(resolve_container_name "$(get_spark_master_container)")
    worker_container=$(resolve_container_name "$(get_spark_worker_container)")

    echo -e "${YELLOW}Checking port availability...${NC}"

    case $service in
        spark|all)
            if ! check_port_available "$spark_port" "$master_container"; then
                echo -e "  ${RED}✗${NC} Port $spark_port (Spark Master) blocked by another process"
                has_conflicts=1
            else
                echo -e "  ${GREEN}✓${NC} Port $spark_port (Spark Master) available"
            fi

            if ! check_port_available "$spark_ui_port" "$master_container"; then
                echo -e "  ${RED}✗${NC} Port $spark_ui_port (Spark UI) blocked by another process"
                has_conflicts=1
            else
                echo -e "  ${GREEN}✓${NC} Port $spark_ui_port (Spark UI) available"
            fi

            local worker_ui_port=$((spark_ui_port + 1))
            if ! check_port_available "$worker_ui_port" "$worker_container"; then
                echo -e "  ${YELLOW}!${NC} Port $worker_ui_port (Spark Worker UI) in use"
            fi
            ;;
    esac

    case $service in
        kafka|all)
            if ! check_port_available 9092 "$(resolve_container_name kafka)"; then
                echo -e "  ${RED}✗${NC} Port 9092 (Kafka) blocked by another process"
                has_conflicts=1
            else
                echo -e "  ${GREEN}✓${NC} Port 9092 (Kafka) available"
            fi

            if ! check_port_available 2181 "$(resolve_container_name zookeeper)"; then
                echo -e "  ${RED}✗${NC} Port 2181 (Zookeeper) blocked by another process"
                has_conflicts=1
            else
                echo -e "  ${GREEN}✓${NC} Port 2181 (Zookeeper) available"
            fi
            ;;
    esac

    case $service in
        unity-catalog|uc)
            if ! check_port_available 8081 "$(resolve_container_name unity-catalog)"; then
                echo -e "  ${RED}✗${NC} Port 8081 (Unity Catalog) blocked by another process"
                has_conflicts=1
            else
                echo -e "  ${GREEN}✓${NC} Port 8081 (Unity Catalog) available"
            fi
            ;;
    esac

    case $service in
        storage)
            if ! check_port_available "5432" "$(get_storage_postgres_container)"; then
                echo -e "  ${RED}✗${NC} Port 5432 (PostgreSQL) blocked by another process"
                has_conflicts=1
            else
                echo -e "  ${GREEN}✓${NC} Port 5432 (PostgreSQL) available"
            fi

            if ! check_port_available "8333" "$(get_storage_seaweedfs_container)"; then
                echo -e "  ${RED}✗${NC} Port 8333 (SeaweedFS S3) blocked by another process"
                has_conflicts=1
            else
                echo -e "  ${GREEN}✓${NC} Port 8333 (SeaweedFS S3) available"
            fi
            ;;
    esac

    if [ $has_conflicts -eq 1 ]; then
        echo -e "\n${RED}Port conflicts detected.${NC}"
        echo -e "${YELLOW}→ Stop conflicting services or use different ports${NC}"
        echo -e "${YELLOW}→ Run './lakehouse status' to see what's running${NC}"
        return 1
    fi

    return 0
}

# Start command
cmd_start() {
    header "STARTING SERVICES"

    local service=$1
    local spark_port=$(get_spark_port)

    # A missing .env makes Compose interpolate blank credentials (POSTGRES_USER,
    # S3 keys, ...) and services then fail obscurely deep in startup. Since
    # env_file is `required: false` (so `docker compose config` renders without a
    # .env), guard it here instead: fail fast with a clear pointer to setup.
    # LAKEHOUSE_ENV_FILE (test overlays) substitutes for .env and is trusted.
    if [ -z "${LAKEHOUSE_ENV_FILE:-}" ] && [ ! -f "$PROJECT_ROOT/.env" ]; then
        echo -e "${RED}✗ No .env file found — services need credentials.${NC}"
        echo -e "   ${YELLOW}→ Run './lakehouse setup' first to generate .env.${NC}"
        return 1
    fi

    # Check port availability before starting
    if ! check_ports_for_service "$service"; then
        echo -e "\n${RED}Aborting start due to port conflicts.${NC}"
        return 1
    fi
    echo ""

    case $service in
        storage|all)
            # `all` starts storage FIRST (this arm runs before the spark/kafka
            # arms below). Since PR #13 moved PostgreSQL/SeaweedFS into Compose,
            # `start all` must bring them up — otherwise Spark/UC/Delta come up
            # pointing at an absent metastore/object store.
            echo -e "${YELLOW}Starting storage (SeaweedFS + PostgreSQL)...${NC}"
            overlay_set_compose_args storage || return 1
            docker compose "${OVERLAY_COMPOSE_ARGS[@]}" up -d
            # pg_isready (not just `nc -z`) so the bootstrap below only runs once
            # PostgreSQL truly accepts connections.
            wait_for_postgres_ready 60 || return 1
            wait_for_service "SeaweedFS S3" "nc -z localhost 8333" 60
            echo -e "${YELLOW}Bootstrapping buckets / prefixes / databases...${NC}"
            # Fail the start if bootstrap fails: init-storage.sh now needs no host
            # aws/psql (dockerized fallbacks + `docker exec` for psql), so a failure
            # here is a real error, not a missing-tool warning. Continuing would
            # bring the rest of the stack up against an un-bootstrapped store.
            if bash scripts/tools/init-storage.sh; then
                echo -e "${GREEN}Storage ready.${NC}"
            else
                echo -e "${RED}✗${NC} init-storage.sh failed — storage was NOT bootstrapped"
                echo -e "${YELLOW}→ Check the output above; ensure Docker is reachable, then re-run './lakehouse start storage'${NC}"
                return 1
            fi
            ;;
    esac

    case $service in
        spark|all)
            echo -e "${YELLOW}Starting Spark 4.1 (port $spark_port, Connect on $(get_spark_connect_port))...${NC}"
            overlay_set_compose_args spark41 || return 1
            docker compose "${OVERLAY_COMPOSE_ARGS[@]}" up -d
            wait_for_service "Spark Connect" "nc -z localhost $(get_spark_connect_port)" 90
            echo -e "${GREEN}Spark Connect endpoint:${NC} $(get_spark_remote)"
            ;;
    esac

    case $service in
        kafka|all)
            echo -e "${YELLOW}Starting Kafka...${NC}"
            overlay_set_compose_args kafka || return 1
            docker compose "${OVERLAY_COMPOSE_ARGS[@]}" up -d
            ;;
    esac

    case $service in
        unity-catalog|uc)
            echo -e "${YELLOW}Starting Unity Catalog...${NC}"
            if [ ! -f "config/unity-catalog/server.properties" ]; then
                echo -e "${YELLOW}Creating server.properties from example...${NC}"
                cp config/unity-catalog/server.properties.example config/unity-catalog/server.properties
                echo -e "${YELLOW}!${NC} Edit config/unity-catalog/server.properties with your S3 credentials"
            fi
            overlay_set_compose_args unity-catalog || return 1
            docker compose "${OVERLAY_COMPOSE_ARGS[@]}" up -d
            wait_for_service "Unity Catalog" "curl -s http://localhost:8081/api/2.1/unity-catalog/catalogs" 60
            ;;
    esac

    case $service in
        airflow)
            echo -e "${YELLOW}Starting Airflow...${NC}"
            # airflow-init creates its DB in the Composed PostgreSQL and the
            # scheduler/webserver need it too — gate on Postgres health so they
            # don't crash-loop against an absent metastore.
            wait_for_postgres_ready 60 || return 1
            mkdir -p logs/airflow
            overlay_set_compose_args airflow || return 1
            docker compose "${OVERLAY_COMPOSE_ARGS[@]}" up -d --build
            wait_for_service "Airflow" "curl -s http://localhost:8085/health" 120
            echo -e "${GREEN}Airflow UI available at: http://localhost:8085${NC}"
            echo -e "${YELLOW}Default credentials: admin/admin (change in .env)${NC}"
            ;;
    esac

    case $service in
        mlflow)
            echo -e "${YELLOW}Starting MLflow...${NC}"
            # The MLflow entrypoint provisions its role + DB in the Composed
            # PostgreSQL, so gate on Postgres health (else it crash-loops).
            wait_for_postgres_ready 60 || return 1
            overlay_set_compose_args mlflow || return 1
            docker compose "${OVERLAY_COMPOSE_ARGS[@]}" up -d
            wait_for_service "MLflow" "curl -s http://localhost:5000/health" 60
            echo -e "${GREEN}MLflow tracking UI at: http://localhost:5000${NC}"
            ;;
    esac

    case $service in
        notebooks)
            # Opt-in only (deliberately NOT part of `start all`), mirroring `stop
            # notebooks`. Needed so a Jupyter stopped via the CLI (or quiesced by
            # `reset`) can be brought back — reset_restore_services calls `cmd_start`.
            echo -e "${YELLOW}Starting notebooks (Jupyter)...${NC}"
            overlay_set_compose_args notebooks || return 1
            docker compose "${OVERLAY_COMPOSE_ARGS[@]}" up -d
            ;;
    esac

    case $service in
        storage|spark|kafka|all|unity-catalog|uc|airflow|mlflow|notebooks)
            ;;
        *)
            echo "Usage: lakehouse start [storage|spark|kafka|airflow|unity-catalog|mlflow|notebooks|all]"
            exit 1
            ;;
    esac

    if [ "$service" = "all" ] || [ "$service" = "spark" ] || [ "$service" = "kafka" ]; then
        echo -e "\n${YELLOW}Waiting for services to be ready...${NC}"
        wait_for_services
        echo ""
    fi
}

