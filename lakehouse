# Migrate command - run schema migrations
cmd_migrate() {
    header "SCHEMA MIGRATION"
    local dry_run=false
    local migrations_dir="$PROJECT_ROOT/schemas"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --dry-run) dry_run=true; shift ;;
            *) shift ;;
        esac
    done

    # Load credentials
    source "$PROJECT_ROOT/.env" 2>/dev/null || true
    local pg_user="${POSTGRES_USER:-postgres}"
    local pg_pass="${POSTGRES_PASSWORD:-}"
    local pg_host="${POSTGRES_HOST:-localhost}"
    pg_host="${pg_host/host.docker.internal/localhost}"
    local pg_port="${POSTGRES_PORT:-5432}"
    local db_name="iceberg_catalog"

    # Check migrations directory
    if [ ! -d "$migrations_dir" ]; then
        echo -e "${YELLOW}!${NC} No schemas/ directory found"
        echo -e "   ${YELLOW}→ Create schemas/iceberg/ with migration files${NC}"
        return 0
    fi

    # Ensure migrations tracking table exists
    PGPASSWORD="$pg_pass" psql -h "$pg_host" -p "$pg_port" -U "$pg_user" -d "$db_name" -c "
        CREATE TABLE IF NOT EXISTS _migrations (
            id SERIAL PRIMARY KEY,
            filename VARCHAR(255) UNIQUE NOT NULL,
            applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        );
    " >/dev/null 2>&1

    # Find and apply migrations
    local applied_count=0
    for migration_file in $(find "$migrations_dir" -name "*.sql" -type f | sort); do
        local filename=$(basename "$migration_file")

        # Security: Validate filename contains only safe characters (alphanumeric, underscore, hyphen, dot)
        if [[ ! "$filename" =~ ^[a-zA-Z0-9_.-]+\.sql$ ]]; then
            echo -e "   ${RED}✗${NC} Skipping unsafe filename: $filename"
            continue
        fi

        # Security: Escape single quotes in filename for SQL (double them)
        local safe_filename="${filename//\'/\'\'}"

        # Check if already applied
        local is_applied=$(PGPASSWORD="$pg_pass" psql -h "$pg_host" -p "$pg_port" -U "$pg_user" -d "$db_name" -t -c "
            SELECT COUNT(*) FROM _migrations WHERE filename = '$safe_filename';
        " 2>/dev/null | tr -d ' ')

        if [ "$is_applied" = "1" ]; then
            echo -e "   ${GREEN}✓${NC} $filename (already applied)"
            continue
        fi

        if [ "$dry_run" = true ]; then
            echo -e "   ${YELLOW}→${NC} $filename (would apply)"
        else
            echo -e "   ${BLUE}→${NC} Applying $filename..."
            if PGPASSWORD="$pg_pass" psql -h "$pg_host" -p "$pg_port" -U "$pg_user" -d "$db_name" -f "$migration_file" >/dev/null 2>&1; then
                PGPASSWORD="$pg_pass" psql -h "$pg_host" -p "$pg_port" -U "$pg_user" -d "$db_name" -c "
                    INSERT INTO _migrations (filename) VALUES ('$safe_filename');
                " >/dev/null 2>&1
                echo -e "   ${GREEN}✓${NC} $filename applied"
                ((applied_count++))
            else
                echo -e "   ${RED}✗${NC} $filename failed"
                return 1
            fi
        fi
    done

    echo -e "\n${BLUE}================================${NC}"
    if [ "$dry_run" = true ]; then
        echo -e "${YELLOW}Dry run complete - no changes made${NC}"
    else
        echo -e "${GREEN}Migration complete - $applied_count new migrations applied${NC}"
    fi
}

# Setup command - validates and configures everything
cmd_setup() {
    header "LAKEHOUSE SETUP"
    local has_errors=0

    # Step 1.1: Check for GNU tools, when on MacOS
	if [ -f /usr/bin/sw_vers ]
	then
		echo -e "\n${YELLOW}1.1. Checking for GNU tools when on MacOS...${NC}"
		if ! check_gnutools_on_macos; then
			echo -e "\n${RED}Please install GNU tools on MacOS before continuing.${NC}"
			echo "See SETUP.md for installation instructions."
			has_errors=1
		else
			echo -e "${GREEN}✓ All required tools installed when on MacOS${NC}"
		fi
	fi

    # Step 1.2: Check prerequisites
    echo -e "\n${YELLOW}1.2. Checking prerequisites...${NC}"
    if ! check_prerequisites; then
        echo -e "\n${RED}Please install missing tools before continuing.${NC}"
        echo "See SETUP.md for installation instructions."
        has_errors=1
    else
        echo -e "${GREEN}✓ All required tools installed${NC}"
    fi

    # Step 2: Check .env file
    echo -e "\n${YELLOW}2. Checking configuration files...${NC}"
    if [ ! -f "$PROJECT_ROOT/.env" ]; then
        if [ -f "$PROJECT_ROOT/.env.example" ]; then
            cp "$PROJECT_ROOT/.env.example" "$PROJECT_ROOT/.env"
            echo -e "${YELLOW}!${NC} Created .env from .env.example"
            echo -e "  ${YELLOW}→ Please edit .env with your credentials${NC}"
            has_errors=1
        else
            echo -e "${RED}✗${NC} Missing .env and .env.example"
            has_errors=1
        fi
    else
        echo -e "${GREEN}✓${NC} .env exists"
        # Validate required variables
        source "$PROJECT_ROOT/.env"
        local env_ok=1
        [ -z "$POSTGRES_USER" ] && echo -e "  ${RED}✗${NC} POSTGRES_USER not set" && env_ok=0
        [ -z "$S3_ACCESS_KEY" ] && echo -e "  ${RED}✗${NC} S3_ACCESS_KEY not set" && env_ok=0
        [ "$POSTGRES_USER" = "your_username" ] && echo -e "  ${YELLOW}!${NC} POSTGRES_USER still has default value" && env_ok=0
        [ "$S3_ACCESS_KEY" = "your_access_key_here" ] && echo -e "  ${YELLOW}!${NC} S3_ACCESS_KEY still has default value" && env_ok=0
        [ $env_ok -eq 1 ] && echo -e "  ${GREEN}✓${NC} Required variables set"
    fi

    # Step 3: Check Spark config
    if [ ! -f "$PROJECT_ROOT/config/spark/spark-defaults.conf" ]; then
        if [ -f "$PROJECT_ROOT/config/spark/spark-defaults.conf.example" ]; then
            cp "$PROJECT_ROOT/config/spark/spark-defaults.conf.example" "$PROJECT_ROOT/config/spark/spark-defaults.conf"
            echo -e "${YELLOW}!${NC} Created spark-defaults.conf from example"
            echo -e "  ${YELLOW}→ Please edit with your S3/PostgreSQL credentials${NC}"
            has_errors=1
        else
            echo -e "${RED}✗${NC} Missing spark-defaults.conf"
            has_errors=1
        fi
    else
        echo -e "${GREEN}✓${NC} spark-defaults.conf exists"
        # Validate credential consistency
        check_credential_consistency
    fi

    # Step 4: Check JARs
    echo -e "\n${YELLOW}3. Checking JAR dependencies...${NC}"
    local jars_dir="$PROJECT_ROOT/jars"
    local required_jars=(
        "iceberg-spark-runtime-4.0_2.13-1.10.0.jar"
        "hadoop-aws-3.4.1.jar"
        "aws-java-sdk-bundle-1.12.780.jar"
        "bundle-2.24.6.jar"
        "postgresql-42.7.4.jar"
    )
    local missing_jars=0
    for jar in "${required_jars[@]}"; do
        if [ ! -f "$jars_dir/$jar" ]; then
            echo -e "  ${RED}✗${NC} Missing $jar"
            missing_jars=1
        fi
    done

    if [ $missing_jars -eq 1 ]; then
        echo -e "\n${YELLOW}Downloading missing JARs...${NC}"
        if [ -f "$PROJECT_ROOT/scripts/tools/download-jars.sh" ]; then
            bash "$PROJECT_ROOT/scripts/tools/download-jars.sh"
        else
            echo -e "${RED}✗${NC} download-jars.sh not found"
            has_errors=1
        fi
    else
        echo -e "${GREEN}✓${NC} All required JARs present"
        # Verify JAR checksums if available
        if [ -f "$PROJECT_ROOT/scripts/tools/download-jars.sh" ]; then
            bash "$PROJECT_ROOT/scripts/tools/download-jars.sh" --verify-only 2>/dev/null && \
                echo -e "  ${GREEN}✓${NC} JAR checksums verified" || \
                echo -e "  ${YELLOW}!${NC} JAR checksum verification skipped"
        fi
    fi

    # Step 5: Install Python dependencies
    echo -e "\n${YELLOW}4. Installing Python dependencies...${NC}"
    if check_cmd poetry; then
        poetry install --quiet && echo -e "${GREEN}✓${NC} Python dependencies installed" || {
            echo -e "${RED}✗${NC} Poetry install failed"
            has_errors=1
        }
    fi

    # Step 6: Setup PostgreSQL database
    echo -e "\n${YELLOW}5. Setting up PostgreSQL database...${NC}"
    if check_cmd psql && [ -n "$POSTGRES_USER" ] && [ "$POSTGRES_USER" != "your_username" ]; then
        setup_postgres || has_errors=1
    else
        echo -e "   ${YELLOW}!${NC} Skipping PostgreSQL setup (psql not available or credentials not configured)"
    fi

    # Step 7: Check disk space
    echo -e "\n${YELLOW}6. Checking disk space...${NC}"
    local free_gb=$($DF_TOOL -BG "$PROJECT_ROOT" | tail -1 | awk '{print $4}' | tr -d 'G')
    if [ "$free_gb" -lt 10 ] 2>/dev/null; then
        echo -e "${YELLOW}!${NC} Low disk space: ${free_gb}GB free (10GB+ recommended)"
    else
        echo -e "${GREEN}✓${NC} Disk space OK (${free_gb}GB free)"
    fi

    # Step 8: Check for port conflicts
    echo -e "\n${YELLOW}7. Checking for port conflicts...${NC}"
    for port in 5432 8333 9092 2181 7078 8081 8082 8085 5000 5001; do
        if nc -z localhost $port 2>/dev/null; then
            case $port in
                5432) echo -e "  ${GREEN}✓${NC} Port $port in use (PostgreSQL expected)" ;;
                8333) echo -e "  ${GREEN}✓${NC} Port $port in use (SeaweedFS expected)" ;;
                *) echo -e "  ${YELLOW}!${NC} Port $port already in use" ;;
            esac
        fi
    done

    # Summary
    echo -e "\n${BLUE}================================${NC}"
    if [ $has_errors -eq 0 ]; then
        echo -e "${GREEN}Setup complete!${NC}"
        echo -e "\nNext steps:"
        echo "  1. Start services:  ./lakehouse start all"
        echo "  2. Run tests:       ./lakehouse test"
        echo "  3. Run migrations:  ./lakehouse migrate"
    else
        echo -e "${YELLOW}Setup incomplete - please address the issues above${NC}"
        echo -e "\nSee SETUP.md for detailed instructions."
        return 1
    fi
}

# ============================================================================
# Lifecycle commands: reset / backup / restore / doctor  (PR #0, Phase 1.5)
# ----------------------------------------------------------------------------
# These are TOP-LEVEL COMMANDS, not services (plan 1.13.3). Each is registered at
# four sites — argument parsing (the connect-mode bypass), a cmd_<name>() function,
# the top-level case dispatch, and cmd_help() — never the 7-site service model, and
# never in the start/stop/logs service dispatch.
# ============================================================================

# Detect Unity Catalog's effective state backend from CONFIG, never from volume
# topology (T-1.5.1, plan 1.14.5). Reads the live server.properties if present,
# else the image default (embedded H2). Prints "h2" or "postgresql:<db>".
# Optional $1 overrides the properties path (used by unit tests).
# shellcheck disable=SC2120  # $1 is an intentional optional override, not always passed
detect_uc_backend() {
    local props="${1:-$PROJECT_ROOT/config/unity-catalog/server.properties}"
    if [ -f "$props" ]; then
        local url
        url=$(grep -E '^[[:space:]]*hibernate\.connection\.url=jdbc:postgresql:' "$props" 2>/dev/null | head -1 || true)
        if [ -n "$url" ]; then
            local db=""
            case "$url" in
                */*) db="${url##*/}" ;;  # standard form jdbc:postgresql://host:port/<db>
                *)   db="${url##*:}" ;;  # slash-less form jdbc:postgresql:<db>
            esac
            db="${db%%\?*}"            # drop any ?jdbcParams suffix
            db="${db%%[[:space:]]*}"   # drop trailing whitespace/comment
            # NB: keep '-' and '.' — they are legal in a PostgreSQL database name.
            if [ -n "$db" ]; then
                echo "postgresql:${db}"
                return 0
            fi
        fi
    fi
    # No live config, or the PostgreSQL block is commented out -> embedded H2.
    echo "h2"
    return 0
}

# Named volumes declared by the ACTIVE BASE compose set only — never *.test.yml
# overlays or $LAKEHOUSE_OVERLAY_DIR (plan 1.16.6). One name per line.
reset_discover_volumes() {
    local f
    for f in "$PROJECT_ROOT"/docker-compose-*.yml; do
        case "$f" in
            *.test.yml) continue ;;
        esac
        awk '
            /^volumes:/ { inv=1; next }
            /^[^[:space:]#]/ { inv=0 }
            inv && /^[[:space:]]+[A-Za-z0-9_-]+:[[:space:]]*$/ {
                name=$1; sub(/:$/,"",name); print name
            }
        ' "$f"
    done | sort -u
    return 0
}

# Which reset modes destroy a given named volume (plan 1.14.7). Prints a
# comma-list of modes, or "never" for the explicit never-destroy list.
reset_volume_mode() {
    case "$1" in
        mlflow-data)           echo "metadata,all" ;;  # tracking state (kept by --keep-mlflow)
        uc-data)               echo "metadata,all" ;;  # catalog state (mounted PR #13/T-1.20b)
        uc-logs)               echo "never" ;;         # diagnostics — never destroyed
        # Composed storage (PR #13/T-1.2): postgres-data holds EVERY database and
        # seaweedfs-data the WHOLE object store. Their CONTENT is reset by the
        # database drop-recreate and S3 bucket-clear steps (emitted separately in
        # the plan) — the volumes themselves are NEVER removed. reset does not
        # quiesce the storage services, so `docker volume rm` on these would fail
        # ("in use") anyway; and a volume wipe is unnecessary since the content is
        # already reset in place. Marked "never" so `--dry-run` doesn't claim a
        # volume removal that never happens (dry-run honesty). Other volumes whose
        # services ARE quiesced (uc-data, mlflow-data, spark-data) remain removable.
        postgres-data)         echo "never" ;;
        seaweedfs-data)        echo "never" ;;
        spark-data|spark-logs) echo "data,all" ;;      # job scratch + event logs
        *)                     echo "data,all" ;;      # default: data-plane scratch
    esac
    return 0
}

# PostgreSQL databases a mode drops+recreates (plan 1.13.4 as amended by 1.14.1).
# --data preserves all databases; --metadata/--all reset UC(if PG)+airflow+iceberg
# (+mlflow unless --keep-mlflow). Never the non-existent "unitycatalog" (plan 1.13.2).
reset_db_targets() {
    local mode="$1" keep_mlflow="$2"
    case "$mode" in
        metadata|all)
            echo "airflow"
            echo "iceberg_catalog"
            if [ "$keep_mlflow" != "true" ]; then
                echo "mlflow"
            fi
            local uc
            uc=$(detect_uc_backend)
            if [ "${uc%%:*}" = "postgresql" ]; then
                echo "${uc#postgresql:}"
            fi
            ;;
        data) : ;;  # data plane only — databases preserved
    esac
    return 0
}

# Effective (overlay-aware) target NAMES. Under an active overlay these default to
# run-scoped names, but an explicit S3_BUCKET / MLFLOW_PG_DB in the environment STILL
# takes precedence (`${S3_BUCKET:-ol-test-…}`), so a production value CAN influence
# them if LAKEHOUSE_ENV_FILE is unset and the real .env is sourced. Safety therefore
# does NOT rest on these helpers alone: the semantic gate (plan 1.18.2), now wired
# into reset, backup, AND restore, re-derives these and ABORTS unless every target is
# run-scoped. Overlay-inactive, these are the real configured names (unrestricted).
reset_effective_bucket() {
    if [ "${OVERLAY_ACTIVE:-false}" = "true" ]; then
        echo "${S3_BUCKET:-ol-test-${LAKEHOUSE_TEST_RUN_ID}}"
    else
        echo "${S3_BUCKET:-lakehouse}"
    fi
}

# $1 = logical base DB (airflow | iceberg_catalog | mlflow | <uc-pg-db>)
reset_effective_db() {
    local base="$1"
    if [ "${OVERLAY_ACTIVE:-false}" = "true" ]; then
        case "$base" in
            mlflow) echo "${MLFLOW_PG_DB:-ol_test_${LAKEHOUSE_TEST_RUN_ID}_mlflow}" ;;
            *)      echo "ol_test_${LAKEHOUSE_TEST_RUN_ID}_${base}" ;;
        esac
    else
        case "$base" in
            mlflow) echo "${MLFLOW_PG_DB:-mlflow}" ;;
            *)      echo "$base" ;;
        esac
    fi
}

# $1 = short volume name -> the physical docker volume name (project-prefixed).
reset_effective_volume() {
    local proj="${COMPOSE_PROJECT_NAME:-}"
    if [ -z "$proj" ]; then
        # Match Docker Compose's default project-name normalization of the working
        # directory: lowercase, and keep only [a-z0-9_-]. Raw `basename` would miss
        # this, so a repo checked out into e.g. "Open Lakehouse" would target the
        # wrong volume name and silently leave the real data volume untouched.
        proj="$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')"
    fi
    echo "${proj}_$1"
}

# Human-readable total size of an S3 prefix (best-effort; "unknown" if unreachable).
reset_s3_prefix_size() {
    local prefix="$1" line
    line=$(aws_s3 ls "$prefix" --recursive --summarize 2>/dev/null | grep -i 'Total Size:' | tail -1 || true)
    if [ -n "$line" ]; then
        echo "${line##*: }"
    else
        echo "unknown"
    fi
}

# The classified orphan warning a --metadata reset must print (T-1.5.7, D7). It
# reports the THREE classes a metadata reset actually CREATES (plan 1.16.7) —
# recoverable Delta, doubtful Iceberg, unrecoverable MLflow artifacts (with a byte
# size) — NOT the dangling-catalog class (that is pre-existing/manual). With
# --keep-mlflow the unrecoverable-MLflow class is suppressed: two classes (1.15.6).
reset_metadata_warning() {
    local keep_mlflow="$1" bucket
    bucket=$(reset_effective_bucket)
    echo "WARNING: --metadata drops catalog/tracking metadata but KEEPS object storage."
    echo "  Objects left orphaned under s3://${bucket}/warehouse/, by recoverability:"
    echo "  [recoverable]   Delta table prefixes — re-registerable from the Delta transaction log (tooling arrives in a later phase)."
    echo "  [doubtful]      Iceberg table prefixes — UC OSS 0.4.x exposes no Iceberg write endpoints, so re-registration may be impossible."
    if [ "$keep_mlflow" != "true" ]; then
        local size
        size=$(reset_s3_prefix_size "s3://${bucket}/mlflow-artifacts/")
        echo "  [UNRECOVERABLE] MLflow artifacts under s3://${bucket}/mlflow-artifacts/ (${size}) — the Postgres run records that indexed them are being dropped; the bytes become unreachable."
    fi
    return 0
}

# Emit the machine-greppable reset PLAN for a mode. Pure enumeration — issues no
# docker/psql/rm. Tokens: "PLAN target=<class> name=<n> action=<a> [reason=<r>]".
reset_emit_plan() {
    local mode="$1" keep_mlflow="$2"
    local bucket
    bucket=$(reset_effective_bucket)

    local db
    for db in $(reset_db_targets "$mode" "$keep_mlflow"); do
        echo "PLAN target=database name=$(reset_effective_db "$db") action=drop-recreate"
    done

    if [ "$mode" = "metadata" ] || [ "$mode" = "all" ]; then
        local uc
        uc=$(detect_uc_backend)
        if [ "$uc" = "h2" ]; then
            echo "PLAN target=uc-state name=h2-in-container action=reset"
        fi
    fi

    if [ "$mode" = "data" ] || [ "$mode" = "all" ]; then
        echo "PLAN target=s3 name=s3://${bucket}/warehouse/ action=delete"
        echo "PLAN target=s3 name=s3://${bucket}/mlflow-artifacts/ action=delete"
        echo "PLAN target=rows name=uc-table-registrations action=clear"
        echo "PLAN target=rows name=mlflow-run-records action=clear"
        echo "PLAN target=rows name=iceberg_catalog-rows action=clear"
        # NOTE: Kafka topic/checkpoint reset is NOT emitted — it is not implemented in
        # PR #0 (the engine quiesces Kafka but deletes no topics/checkpoints), so
        # advertising it in the plan would make --dry-run lie (review-handoff #4).
        # Deferred to a follow-up PR; the §1.13.4 matrix row is a future target.
    fi

    local v vmode
    for v in $(reset_discover_volumes); do
        vmode=$(reset_volume_mode "$v")
        if [ "$vmode" = "never" ]; then
            echo "PLAN target=volume name=${v} action=preserve reason=never-destroy"
            continue
        fi
        if [ "$keep_mlflow" = "true" ] && [ "$v" = "mlflow-data" ]; then
            echo "PLAN target=volume name=${v} action=preserve reason=keep-mlflow"
            continue
        fi
        case ",${vmode}," in
            *",${mode},"*) echo "PLAN target=volume name=${v} action=remove" ;;
            *)             echo "PLAN target=volume name=${v} action=preserve reason=other-mode" ;;
        esac
    done
    return 0
}

# --- destructive engine (Checkpoint 3) --------------------------------------------

# Run psql against the configured PostgreSQL. Prefers a host psql (OL's documented
# setup); falls back to a dockerized client so reset works with no host pg client
# (plan 1.17.9 — installing tooling is an impl detail). Host mapping: host psql
# reaches the host DB at localhost; the dockerized client reaches it via the
# host-gateway. All args forwarded to psql.
pg_psql() {
    local host="${POSTGRES_HOST:-localhost}"
    if command -v psql >/dev/null 2>&1; then
        host="${host/host.docker.internal/localhost}"
        PGPASSWORD="${POSTGRES_PASSWORD:-}" psql -h "$host" -p "${POSTGRES_PORT:-5432}" \
            -U "${POSTGRES_USER:-postgres}" "$@"
    else
        # dockerized client: any host-loopback form must become the host-gateway
        host="${host//127.0.0.1/host.docker.internal}"
        host="${host//localhost/host.docker.internal}"
        docker run --rm -i --add-host=host.docker.internal:host-gateway \
            -e PGPASSWORD="${POSTGRES_PASSWORD:-}" \
            "${LAKEHOUSE_PG_CLIENT_IMAGE:-postgres:16-alpine}" \
            psql -h "$host" -p "${POSTGRES_PORT:-5432}" -U "${POSTGRES_USER:-postgres}" "$@"
    fi
}

# Run `aws s3 ...` against the configured S3/SeaweedFS. Prefers host aws; falls back
# to a dockerized aws-cli. Endpoint host mapping mirrors pg_psql.
aws_s3() {
    local ep="${S3_ENDPOINT:-http://localhost:8333}"
    if command -v aws >/dev/null 2>&1; then
        ep="${ep/host.docker.internal/localhost}"
        AWS_ACCESS_KEY_ID="${S3_ACCESS_KEY:-}" AWS_SECRET_ACCESS_KEY="${S3_SECRET_KEY:-}" \
            aws --endpoint-url "$ep" s3 "$@"
    else
        # dockerized client: any host-loopback form must become the host-gateway
        ep="${ep//127.0.0.1/host.docker.internal}"
        ep="${ep//localhost/host.docker.internal}"
        docker run --rm --add-host=host.docker.internal:host-gateway \
            -e AWS_ACCESS_KEY_ID="${S3_ACCESS_KEY:-}" -e AWS_SECRET_ACCESS_KEY="${S3_SECRET_KEY:-}" \
            "${LAKEHOUSE_AWSCLI_IMAGE:-amazon/aws-cli:2.24.6}" --endpoint-url "$ep" s3 "$@"
    fi
}

# Reject a database name that isn't a safe identifier before it is interpolated into
# any SQL (review-handoff #3). Names originate from the JDBC-URL parse, MLFLOW_PG_DB,
# and (historically) the MANIFEST — none fully trusted. Allow only [A-Za-z0-9_.-]
# (the set legal for our DB names, matching detect_uc_backend's parse), so a value
# containing a quote/semicolon/space cannot break out of the datname='...' literal or
# the "..." identifier.
pg_assert_valid_dbname() {
    case "$1" in
        "" | *[!a-zA-Z0-9_.-]*)
            echo -e "  ${RED}!${NC} refusing unsafe database name: '$1'" >&2
            return 1 ;;
    esac
    return 0
}

# Safe DROP sequence (T-1.5.4): capture owner -> terminate live backends -> DROP ->
# CREATE with the original owner. Survives open connections to the target DB.
pg_drop_recreate() {
    local db="$1" owner
    pg_assert_valid_dbname "$db" || return 1
    owner=$(pg_psql -d postgres -tAc \
        "SELECT pg_catalog.pg_get_userbyid(datdba) FROM pg_database WHERE datname='${db}'" \
        2>/dev/null | tr -d '[:space:]' || true)
    pg_psql -d postgres -c \
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='${db}' AND pid <> pg_backend_pid();" \
        >/dev/null 2>&1 || true
    pg_psql -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS \"${db}\";" || return 1
    if [ -n "$owner" ]; then
        pg_psql -d postgres -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"${db}\" OWNER \"${owner}\";" || return 1
    else
        pg_psql -d postgres -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"${db}\";" || return 1
    fi
    return 0
}

# Runtime semantic validation (plan 1.18.2, U-66b/I-55). ONLY when the overlay is
# active: resolve the effective targets and abort unless every database, bucket,
# volume, and container name derives from the current run-id. Overlay-inactive
# production reset is unrestricted (must not reintroduce the 1.14.3 defect).
reset_semantic_gate() {
    [ "${OVERLAY_ACTIVE:-false}" = "true" ] || return 0
    local rid="${LAKEHOUSE_TEST_RUN_ID}"
    local dbs buckets volumes containers v
    dbs="$(reset_effective_db airflow) $(reset_effective_db iceberg_catalog) $(reset_effective_db mlflow)"
    local uc
    uc=$(detect_uc_backend)
    [ "${uc%%:*}" = "postgresql" ] && dbs="$dbs $(reset_effective_db "${uc#postgresql:}")"
    buckets="$(reset_effective_bucket)"
    volumes=""
    for v in $(reset_discover_volumes); do
        volumes="$volumes $(reset_effective_volume "$v")"
    done
    containers="$(resolve_container_name spark-master-41) $(resolve_container_name kafka) \
$(resolve_container_name unity-catalog) $(resolve_container_name mlflow) \
$(resolve_container_name airflow-webserver)"
    if ! overlay_validate_targets --runid "$rid" --active true \
        --databases "$dbs" --buckets "$buckets" --volumes "$volumes" --containers "$containers"; then
        echo -e "${RED}reset: overlay semantic validation FAILED${NC} — a resolved target is not scoped to run-id '${rid}'. Refusing to touch anything." >&2
        return 1
    fi
    return 0
}

# The service keys currently running (by resolved container name), for restore.
reset_running_services() {
    local up=""
    is_container_running "$(resolve_container_name spark-master-41)" && up="$up spark" || true
    is_container_running "$(resolve_container_name kafka)" && up="$up kafka" || true
    is_container_running "$(resolve_container_name unity-catalog)" && up="$up unity-catalog" || true
    is_container_running "$(resolve_container_name airflow-webserver)" && up="$up airflow" || true
    is_container_running "$(resolve_container_name mlflow)" && up="$up mlflow" || true
    # Jupyter is a writer reset_quiesce stops (reset_stop_services ... notebooks), so
    # it must be in the restart set too — else a running Jupyter is left stopped after
    # a successful reset. cmd_start now has a `notebooks` arm to bring it back.
    is_container_running "$(resolve_container_name jupyter)" && up="$up notebooks" || true
    echo "$up"
    return 0
}

# Resolved container names a service key owns — used to VERIFY quiescence actually
# took effect (review-handoff #7), so destructive work never proceeds against a
# writer that failed to stop.
quiesce_containers_for() {
    case "$1" in
        spark)         echo "$(resolve_container_name spark-master-41) $(resolve_container_name spark-worker-41) $(resolve_container_name spark-connect-41)" ;;
        kafka)         echo "$(resolve_container_name kafka) $(resolve_container_name zookeeper)" ;;
        unity-catalog) resolve_container_name unity-catalog ;;
        mlflow)        resolve_container_name mlflow ;;
        airflow)       echo "$(resolve_container_name airflow-webserver) $(resolve_container_name airflow-scheduler) $(resolve_container_name airflow-triggerer)" ;;
        notebooks)     resolve_container_name jupyter ;;
    esac
}

# Stop each service and CONFIRM its containers are actually down. Returns non-zero if
# any remain running, so the caller can abort before touching data (a stop that
# silently failed must not let a live writer race the deletion — review-handoff #7).
reset_stop_services() {
    local s c rc=0
    for s in "$@"; do
        echo -e "${YELLOW}Quiescing ${s}...${NC}"
        cmd_stop "$s" >/dev/null 2>&1 || true
        for c in $(quiesce_containers_for "$s"); do
            if is_container_running "$c"; then
                echo -e "  ${RED}!${NC} ${c} still running after quiesce" >&2
                rc=1
            fi
        done
    done
    return "$rc"
}

# Quiesce the services that WRITE to a mode's targets (plan 1.15.3). --data keeps
# Unity Catalog UP (its registrations are cleared via REST); --metadata stops the
# DB clients; --all stops everything.
# Returns non-zero if any writer for the mode failed to stop (propagated from
# reset_stop_services). --data intentionally keeps Unity Catalog UP (its
# registrations are cleared via REST), so UC is not in the --data set.
reset_quiesce() {
    case "$1" in
        data)     reset_stop_services spark kafka mlflow airflow notebooks ;;
        metadata) reset_stop_services unity-catalog mlflow airflow notebooks ;;
        all)      reset_stop_services spark kafka unity-catalog mlflow airflow notebooks ;;
    esac
}

# Restore the previously-running set — ONLY on success (plan 1.16.5 / 1.19.3).
reset_restore_services() {
    local s
    for s in $1; do
        echo -e "${YELLOW}Restarting ${s}...${NC}"
        cmd_start "$s" >/dev/null 2>&1 || echo -e "  ${YELLOW}!${NC} ${s} did not come back cleanly; check ./lakehouse status"
    done
    return 0
}

reset_marker_path() { echo "$PROJECT_ROOT/.lakehouse-reset-interrupted"; }

# On a FAILED destructive reset, leave services stopped and drop a marker with
# recovery instructions (plan 1.16.5). doctor reports it in Checkpoint 5.
reset_write_marker() {
    local mode="$1"
    cat > "$(reset_marker_path)" <<EOF
interrupted-reset
mode=${mode}
timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
overlay_active=${OVERLAY_ACTIVE:-false}
note=A destructive reset failed mid-operation. Services were left STOPPED to avoid
note=compounding corruption by writing against half-deleted state. Inspect state,
note=then restore from a backup ('./lakehouse restore --from <path>') or re-run reset.
EOF
    return 0
}

# --- per-mode deletions -----------------------------------------------------------

# Metadata plane: drop+recreate the catalog/tracking databases, and remove the
# metadata volumes. UC-on-H2 state is reset by the quiesce (down removes the
# container + its ephemeral H2); a PostgreSQL-backed UC DB is dropped here.
reset_delete_metadata() {
    local keep_mlflow="$1" db
    for db in $(reset_db_targets metadata "$keep_mlflow"); do
        local eff
        eff=$(reset_effective_db "$db")
        echo -e "${YELLOW}Resetting database ${eff}...${NC}"
        pg_drop_recreate "$eff" || return 1
    done
    # Metadata-owned named volumes (mlflow-data unless --keep-mlflow, uc-data).
    local v vmode vname
    for v in $(reset_discover_volumes); do
        vmode=$(reset_volume_mode "$v")
        case ",${vmode}," in *",metadata,"*) ;; *) continue ;; esac
        [ "$keep_mlflow" = "true" ] && [ "$v" = "mlflow-data" ] && continue
        vname=$(reset_effective_volume "$v")
        docker volume rm "$vname" >/dev/null 2>&1 || echo -e "  ${YELLOW}!${NC} could not remove volume $vname (in use or absent)" >&2
    done
    return 0
}

# Data plane: empty the object-store prefixes, clear the catalog/tracking ROWS that
# referenced them (only when the owning DB is NOT being dropped — i.e. --data, not
# --all, which drops those DBs wholesale), and remove data volumes. Kafka
# topics/checkpoints are NOT wiped in PR #0 (deferred) — the dry-run plan reflects that.
reset_delete_data() {
    local mode="$1"
    local bucket
    bucket=$(reset_effective_bucket)
    echo -e "${YELLOW}Emptying s3://${bucket}/warehouse/ and mlflow-artifacts/...${NC}"
    # Fail-stop on a genuine S3 error, but NOT on a missing bucket. An unreachable
    # endpoint and an absent bucket both make `rm` exit non-zero, yet only the former
    # is a real failure — a fresh stack whose bucket was never created has simply
    # nothing to delete. So probe the endpoint (lists buckets; rc=0 iff reachable,
    # even with zero buckets): if it is down we fail-stop (plan 1.15.3, I-52b);
    # otherwise the rm's own failure is a benign missing-bucket/empty-prefix no-op.
    if ! aws_s3 ls >/dev/null 2>&1; then
        echo -e "  ${RED}!${NC} S3 endpoint unreachable — cannot empty object store" >&2
        return 1
    fi
    aws_s3 rm "s3://${bucket}/warehouse/" --recursive >/dev/null 2>&1 || true
    aws_s3 rm "s3://${bucket}/mlflow-artifacts/" --recursive >/dev/null 2>&1 || true
    # Post-condition (review-handoff #8): the prefixes must actually be EMPTY. A
    # permission error (AccessDenied) makes `rm` fail while objects remain, which the
    # `|| true` above would otherwise mask into a false success. A missing bucket
    # lists empty (benign). Fail-stop if anything survived the delete.
    local remain
    remain=$(aws_s3 ls "s3://${bucket}/warehouse/" --recursive 2>/dev/null | grep -c . || true)
    remain=$((remain + $(aws_s3 ls "s3://${bucket}/mlflow-artifacts/" --recursive 2>/dev/null | grep -c . || true)))
    if [ "$remain" -ne 0 ]; then
        echo -e "  ${RED}!${NC} object store not empty after delete (${remain} object(s) remain) — check S3 permissions" >&2
        return 1
    fi

    if [ "$mode" = "data" ]; then
        # DBs survive in --data, so clear the dangling rows (plan 1.14.1, 1.18.4) —
        # otherwise --data would manufacture the orphans I-32 forbids. Attempt ALL
        # three (clear as much as possible), then FAIL-STOP if any genuinely failed
        # (review-handoff #5): the object store is already emptied, so leaving stale
        # catalog/tracking rows is exactly the orphaned state --data promises to
        # avoid. reset_execute then writes a marker + leaves services stopped; the
        # operator reconciles with `doctor` rather than trusting a false "complete".
        # (Each helper returns 0 when its table/UC is simply absent — a clean/empty
        # stack does not trip this.)
        local clr_rc=0
        reset_clear_uc_registrations || clr_rc=1
        reset_clear_mlflow_runs || clr_rc=1
        reset_clear_iceberg_rows || clr_rc=1
        if [ "$clr_rc" -ne 0 ]; then
            echo -e "  ${RED}!${NC} dangling-row cleanup incomplete — object store emptied but catalog/tracking rows remain; run './lakehouse doctor'" >&2
            return 1
        fi
    fi

    # Data-plane named volumes (spark-data, spark-logs).
    local v vmode vname
    for v in $(reset_discover_volumes); do
        vmode=$(reset_volume_mode "$v")
        case ",${vmode}," in *",data,"*) ;; *) continue ;; esac
        vname=$(reset_effective_volume "$v")
        docker volume rm "$vname" >/dev/null 2>&1 || echo -e "  ${YELLOW}!${NC} could not remove volume $vname (in use or absent)" >&2
    done
    return 0
}

# Clear UC table registrations, keeping catalogs and schemas. Reaches the RESOLVED
# UC container's INTERNAL REST API via `docker exec` (curl is in the UC image), never
# a host port — under an active overlay the run-scoped UC publishes no host port, so
# hitting localhost:8081 would clobber the PRODUCTION Unity Catalog. It runs a small
# python client that SHARES the resolved UC container's network namespace
# (`docker run --network container:<uc>`), so localhost:8080 is always that exact
# UC — the run-scoped one under an overlay, production otherwise — with no host-port
# dependency (the UC image itself ships neither curl nor python). Skips when the
# resolved UC container is not running.
reset_clear_uc_registrations() {
    local uc img rc=0
    uc=$(resolve_container_name unity-catalog)
    if ! is_container_running "$uc"; then
        return 0  # no UC to clear (its registrations live in the container's H2)
    fi
    img="${LAKEHOUSE_HTTP_IMAGE:-python:3-alpine}"
    docker run -i --rm --network "container:${uc}" --entrypoint python3 "$img" - <<'PY' 2>/dev/null || rc=$?
import json, urllib.request
api = "http://localhost:8080/api/2.1/unity-catalog"
def req(method, path):
    r = urllib.request.Request(api + path, method=method)
    try:
        with urllib.request.urlopen(r, timeout=10) as x:
            return json.load(x) if method == "GET" else {}
    except Exception:
        return {}
def pages(path, key):
    # Follow next_page_token so ALL registrations are cleared, not just page 1
    # (else --data would wipe objects yet leave later tables registered -> orphans).
    sep = "&" if "?" in path else "?"
    token = None
    while True:
        p = path if token is None else f"{path}{sep}page_token={token}"
        d = req("GET", p)
        for item in d.get(key, []):
            yield item
        token = d.get("next_page_token")
        if not token:
            break
for cat in pages("/catalogs", "catalogs"):
    c = cat["name"]
    for sch in pages(f"/schemas?catalog_name={c}", "schemas"):
        s = sch["name"]
        # Materialize the FULL table list BEFORE deleting: UC's next_page_token is
        # offset-based, so deleting while paginating would shift the cursor and skip
        # later pages (leaving stale registrations). list-then-delete avoids that.
        names = [t["name"] for t in pages(f"/tables?catalog_name={c}&schema_name={s}", "tables")]
        for name in names:
            req("DELETE", f"/tables/{c}.{s}.{name}")
PY
    if [ "$rc" -ne 0 ]; then
        # Propagate a genuine failure (netns/image/UC unreachable) so --data can
        # fail-stop rather than report success with tables still registered
        # (review-handoff #5). A not-running UC returned 0 earlier; per-table DELETE
        # errors are retried/observed by the caller's post-state, not swallowed here.
        echo -e "  ${YELLOW}!${NC} UC registration clear failed (may be incomplete)" >&2
        return "$rc"
    fi
    return 0
}

# Delete MLflow run records (mlflow is quiesced; act on its DB directly), keeping
# experiments. TRUNCATE ... CASCADE removes runs plus every FK-dependent row
# (metrics/params/tags/latest_metrics/inputs/input_tags) in one operation with
# correct ordering — an ordered DELETE would trip MLflow's foreign keys. A no-op
# when the MLflow schema is absent; a genuine failure is surfaced, not swallowed.
reset_clear_mlflow_runs() {
    local db
    db=$(reset_effective_db mlflow)
    if [ -z "$(pg_psql -d "$db" -tAc "SELECT to_regclass('runs')" 2>/dev/null | tr -d '[:space:]')" ]; then
        return 0  # no runs table -> nothing to clear
    fi
    if ! pg_psql -d "$db" -c "TRUNCATE TABLE runs CASCADE;" >/dev/null 2>&1; then
        echo -e "  ${YELLOW}!${NC} failed to clear MLflow run records in ${db}" >&2
        return 1
    fi
    return 0
}

# Delete Iceberg JDBC-catalog table rows, keeping the database/namespaces. No-op if
# the catalog table is absent; a genuine failure is surfaced.
reset_clear_iceberg_rows() {
    local db
    db=$(reset_effective_db iceberg_catalog)
    if [ -z "$(pg_psql -d "$db" -tAc "SELECT to_regclass('iceberg_tables')" 2>/dev/null | tr -d '[:space:]')" ]; then
        return 0
    fi
    if ! pg_psql -d "$db" -c "DELETE FROM iceberg_tables;" >/dev/null 2>&1; then
        echo -e "  ${YELLOW}!${NC} failed to clear iceberg_catalog rows in ${db}" >&2
        return 1
    fi
    return 0
}

reset_do_deletions() {
    local mode="$1" keep_mlflow="$2"
    if [ "$mode" = "metadata" ] || [ "$mode" = "all" ]; then
        reset_delete_metadata "$keep_mlflow" || return 1
    fi
    if [ "$mode" = "data" ] || [ "$mode" = "all" ]; then
        reset_delete_data "$mode" || return 1
    fi
    return 0
}

# Orchestrate: semantic gate -> capture running set -> quiesce -> delete -> restore
# ONLY on success; on failure leave services stopped + marker (plan 1.16.5).
reset_execute() {
    local mode="$1" keep_mlflow="$2"
    reset_semantic_gate || return 1
    rm -f "$(reset_marker_path)" 2>/dev/null || true

    local running
    running=$(reset_running_services)
    # Quiesce and CONFIRM writers stopped BEFORE any deletion (review-handoff #7).
    # If quiescence is incomplete, nothing has been deleted yet — restart the prior
    # set and abort cleanly (no marker: state is unchanged).
    if ! reset_quiesce "$mode"; then
        reset_restore_services "$running"
        echo -e "${RED}reset: could not quiesce all writers — aborting before any deletion.${NC} Nothing was changed." >&2
        return 1
    fi

    if ! reset_do_deletions "$mode" "$keep_mlflow"; then
        reset_write_marker "$mode"
        echo -e "${RED}Reset FAILED mid-operation.${NC} Services left stopped to avoid compounding corruption." >&2
        echo -e "  Recovery: restore from a backup or re-run reset. Marker: $(reset_marker_path)" >&2
        return 1
    fi

    reset_restore_services "$running"
    echo -e "${GREEN}Reset complete (mode: ${mode}).${NC}"
    return 0
}

# ./lakehouse reset --data|--metadata|--all [--keep-mlflow] [--dry-run] [--yes]
# Resolves the REAL configured targets (no ^ol_test_ pattern guard — the
# fail-closed guard lives only in the test harness, plan 1.14.3 / U-54).
cmd_reset() {
    local mode="" keep_mlflow=false dry_run=false assume_yes=false modes_set=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --data)        mode="data";     modes_set=$((modes_set + 1)); shift ;;
            --metadata)    mode="metadata"; modes_set=$((modes_set + 1)); shift ;;
            --all)         mode="all";      modes_set=$((modes_set + 1)); shift ;;
            --keep-mlflow) keep_mlflow=true; shift ;;
            --dry-run)     dry_run=true;     shift ;;
            --yes|-y)      assume_yes=true;  shift ;;
            *) echo "reset: unknown argument '$1'" >&2; return 2 ;;
        esac
    done

    # Flag validation (T-1.5.3b, plan 1.14.9): exactly one primary mode;
    # --keep-mlflow only with --metadata.
    if [ "$modes_set" -ne 1 ]; then
        echo "reset: exactly one of --data / --metadata / --all is required" >&2
        return 2
    fi
    if [ "$keep_mlflow" = true ] && [ "$mode" != "metadata" ]; then
        echo "reset: --keep-mlflow is valid only with --metadata" >&2
        return 2
    fi

    # --dry-run enumerates the plan and changes nothing; it bypasses confirmation
    # because it destroys nothing (plan 1.13.5).
    if [ "$dry_run" = true ]; then
        local label="$mode"
        [ "$keep_mlflow" = true ] && label="$mode --keep-mlflow"
        echo "Reset plan (mode: ${label}) — DRY RUN, no changes will be made:"
        reset_emit_plan "$mode" "$keep_mlflow"
        if [ "$mode" = "metadata" ]; then
            echo ""
            reset_metadata_warning "$keep_mlflow"
        fi
        echo "No changes made (dry-run)."
        return 0
    fi

    # The classified-orphan warning is shown before a real --metadata reset too.
    if [ "$mode" = "metadata" ]; then
        reset_metadata_warning "$keep_mlflow"
    fi

    # Destructive path requires confirmation: --yes, or an interactive 'yes'.
    if [ "$assume_yes" != true ]; then
        if [ -t 0 ]; then
            echo -e "${RED}This will PERMANENTLY reset (mode: ${mode}).${NC} Type 'yes' to proceed:"
            local reply
            read -r reply
            if [ "$reply" != "yes" ]; then
                echo "Aborted."
                return 1
            fi
        else
            echo "reset: refusing a destructive reset without --yes (non-interactive)" >&2
            return 1
        fi
    fi

    reset_execute "$mode" "$keep_mlflow"
}

# --- backup / restore engine (Checkpoint 4, T-1.5.5 / T-1.5.5b / T-1.5.5c) --------
#
# backup and restore share ONE snapshot code path (backup_take_snapshot) and ONE
# quiesce model (backup_quiesce_writers/backup_unquiesce_writers). The snapshot path
# NEVER restarts services, so restore can take its pre-restore snapshot inside the
# same quiesced window it later mutates in (plan 1.16.9). Quiescing uses `docker stop`
# (container-preserving), NOT `docker compose down`, so a stopped UC container's H2
# file survives for `docker cp` (plan 1.15.1) and restarts are cheap `docker start`s.

# The app containers that WRITE to PostgreSQL / S3 / UC. The storage substrate itself
# (host PostgreSQL + SeaweedFS) is intentionally excluded — it must stay up to be
# dumped/synced. One resolved (overlay-aware) name per line.
backup_writer_containers() {
    local c
    # Includes spark-mlflow-agent (logs MLflow runs) and jupyter (writes S3/UC/MLflow):
    # backup/restore quiesce with per-container `docker stop`, so every writer must be
    # named here — unlike reset, whose cmd_stop takes a whole compose file down. Names
    # absent from the running set are skipped (is_container_running is false).
    for c in spark-master-41 spark-worker-41 spark-connect-41 kafka zookeeper \
             unity-catalog mlflow spark-mlflow-agent jupyter \
             airflow-webserver airflow-scheduler airflow-triggerer; do
        resolve_container_name "$c"
    done
}

# Stop every currently-running writer, recording it in QUIESCED_WRITERS for restart.
# (`while read` under process substitution runs in THIS shell, so the array persists.)
backup_quiesce_writers() {
    QUIESCED_WRITERS=()
    local c rc=0
    while read -r c; do
        if is_container_running "$c"; then
            QUIESCED_WRITERS+=("$c")
            echo -e "${YELLOW}Quiescing ${c}...${NC}"
            docker stop "$c" >/dev/null 2>&1 || true
            # Confirm it actually stopped — a snapshot/mutation must not proceed while
            # a writer is still live (review-handoff #7). Still recorded in
            # QUIESCED_WRITERS so the caller restarts it on abort.
            if is_container_running "$c"; then
                echo -e "  ${RED}!${NC} ${c} still running after quiesce" >&2
                rc=1
            fi
        fi
    done < <(backup_writer_containers)
    return "$rc"
}

# Restart the writers recorded by backup_quiesce_writers (docker start — layers intact).
backup_unquiesce_writers() {
    local c
    for c in "${QUIESCED_WRITERS[@]}"; do
        echo -e "${YELLOW}Restarting ${c}...${NC}"
        docker start "$c" >/dev/null 2>&1 || echo -e "  ${YELLOW}!${NC} ${c} did not restart cleanly; check ./lakehouse status" >&2
    done
    return 0
}

# pg_dump a single database to <dir>/<db>.dump — custom format WITH --create, so the
# archive carries CREATE DATABASE ... OWNER and object GRANTs (I-29 ownership/grants).
# Always uses a version-matched dockerized client (PR #13/T-1.20a): the Composed
# PostgreSQL is a pinned major version (16), and a host pg_dump of an OLDER major
# aborts with "server version mismatch". Pinning LAKEHOUSE_PG_CLIENT_IMAGE to the
# server's major keeps backup/restore correct regardless of the host's pg tooling.
pg_dump_db() {
    local db="$1" dir="$2" host="${POSTGRES_HOST:-localhost}"
    host="${host//127.0.0.1/host.docker.internal}"; host="${host//localhost/host.docker.internal}"
    docker run --rm --add-host=host.docker.internal:host-gateway \
        -e PGPASSWORD="${POSTGRES_PASSWORD:-}" -v "${dir}:/backup" \
        "${LAKEHOUSE_PG_CLIENT_IMAGE:-postgres:16-alpine}" \
        pg_dump -h "$host" -p "${POSTGRES_PORT:-5432}" -U "${POSTGRES_USER:-postgres}" \
        -Fc --create -d "$db" -f "/backup/${db}.dump"
}

# Restore a single database from <dir>/<db>.dump. --create --clean --if-exists drops
# and recreates the DB with its backed-up owner, then restores objects+grants. We
# terminate live backends first so the DROP can proceed (the writers are already
# quiesced; this clears any stray session).
pg_restore_db() {
    local db="$1" dir="$2" host="${POSTGRES_HOST:-localhost}"
    pg_assert_valid_dbname "$db" || return 1
    pg_psql -d postgres -c \
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='${db}' AND pid <> pg_backend_pid();" \
        >/dev/null 2>&1 || true
    # Version-matched dockerized client (see pg_dump_db) — also what I-53 asserts.
    host="${host//127.0.0.1/host.docker.internal}"; host="${host//localhost/host.docker.internal}"
    docker run --rm --add-host=host.docker.internal:host-gateway \
        -e PGPASSWORD="${POSTGRES_PASSWORD:-}" -v "${dir}:/backup:ro" \
        "${LAKEHOUSE_PG_CLIENT_IMAGE:-postgres:16-alpine}" \
        pg_restore -h "$host" -p "${POSTGRES_PORT:-5432}" -U "${POSTGRES_USER:-postgres}" \
        --create --clean --if-exists -d postgres "/backup/${db}.dump"
}

# Sync between S3 and a LOCAL directory. Prefers host aws; else a dockerized aws-cli
# with the local dir mounted. Endpoint host mapping mirrors aws_s3().
#   download : s3://<bucket>/ -> <localdir>/
#   upload   : <localdir>/    -> s3://<bucket>/ --delete  (removes strays, T-1.5.5b)
s3_sync() {
    local direction="$1" bucket="$2" localdir="$3"
    local ep="${S3_ENDPOINT:-http://localhost:8333}"
    local extra=()
    if command -v aws >/dev/null 2>&1; then
        ep="${ep/host.docker.internal/localhost}"
        local src dst
        if [ "$direction" = download ]; then src="s3://${bucket}/"; dst="${localdir}/"
        else src="${localdir}/"; dst="s3://${bucket}/"; extra=(--delete); fi
        AWS_ACCESS_KEY_ID="${S3_ACCESS_KEY:-}" AWS_SECRET_ACCESS_KEY="${S3_SECRET_KEY:-}" \
            aws --endpoint-url "$ep" s3 sync "$src" "$dst" "${extra[@]}"
    else
        ep="${ep//127.0.0.1/host.docker.internal}"; ep="${ep//localhost/host.docker.internal}"
        local src dst
        if [ "$direction" = download ]; then src="s3://${bucket}/"; dst="/data/"
        else src="/data/"; dst="s3://${bucket}/"; extra=(--delete); fi
        docker run --rm --add-host=host.docker.internal:host-gateway \
            -e AWS_ACCESS_KEY_ID="${S3_ACCESS_KEY:-}" -e AWS_SECRET_ACCESS_KEY="${S3_SECRET_KEY:-}" \
            -v "${localdir}:/data" \
            "${LAKEHOUSE_AWSCLI_IMAGE:-amazon/aws-cli:2.24.6}" \
            --endpoint-url "$ep" s3 sync "$src" "$dst" "${extra[@]}"
    fi
}

# tar a docker named volume's contents to <dir>/<vol>.tar (best-effort — an absent
# volume is skipped, not an error: not every declared volume is materialised).
volume_backup() {
    local vol="$1" dir="$2"
    if ! docker volume inspect "$vol" >/dev/null 2>&1; then
        echo -e "  ${YELLOW}!${NC} volume ${vol} absent — skipping" >&2
        return 0
    fi
    docker run --rm -v "${vol}:/v:ro" -v "${dir}:/backup" \
        "${LAKEHOUSE_ALPINE_IMAGE:-alpine:latest}" \
        tar cf "/backup/${vol}.tar" -C /v . || return 1
    return 0
}

# Restore a docker named volume from its tar (recreate volume, wipe, extract).
volume_restore() {
    local vol="$1" tarfile="$2"
    [ -f "$tarfile" ] || return 0
    docker volume create "$vol" >/dev/null 2>&1 || true
    docker run --rm -v "${vol}:/v" -v "$(dirname "$tarfile"):/backup:ro" \
        "${LAKEHOUSE_ALPINE_IMAGE:-alpine:latest}" \
        sh -c "rm -rf /v/..?* /v/.[!.]* /v/* 2>/dev/null; tar xf \"/backup/$(basename "$tarfile")\" -C /v" || return 1
    return 0
}

# Copy the resolved UC container's H2 file OUT to <dir>/uc/ (docker cp works on a
# stopped container, so the file is at rest during the quiesced window). Best-effort.
uc_h2_backup() {
    local dir="$1" uc
    uc=$(resolve_container_name unity-catalog)
    if ! docker container inspect "$uc" >/dev/null 2>&1; then
        echo -e "  ${YELLOW}!${NC} UC container ${uc} absent — no H2 state to back up" >&2
        return 0
    fi
    mkdir -p "${dir}/uc"
    docker cp "${uc}:/home/unitycatalog/etc/db/h2db.mv.db" "${dir}/uc/h2db.mv.db" 2>/dev/null \
        || echo -e "  ${YELLOW}!${NC} UC H2 file not found in ${uc}" >&2
    return 0
}

# Copy an H2 file back INTO the resolved (stopped) UC container; the caller restarts
# UC afterwards so it reloads the restored state. Hard-fails if UC is absent.
uc_h2_restore() {
    local dir="$1" uc
    uc=$(resolve_container_name unity-catalog)
    [ -f "${dir}/uc/h2db.mv.db" ] || return 0
    if ! docker container inspect "$uc" >/dev/null 2>&1; then
        echo -e "  ${RED}!${NC} UC container ${uc} absent — cannot restore H2 state" >&2
        return 1
    fi
    docker cp "${dir}/uc/h2db.mv.db" "${uc}:/home/unitycatalog/etc/db/h2db.mv.db" || return 1
    return 0
}

# Take a full snapshot into <dir>. ASSUMES the writers are already quiesced. Does NOT
# quiesce or restart (so restore can reuse it inside one window, plan 1.16.9). Writes
# MANIFEST LAST — its presence is the success marker restore checks. Fail-stop.
backup_take_snapshot() {
    local dir="$1"
    # Clear OUR OWN subdirs so a snapshot is always an authoritative mirror even when
    # an explicit --out is reused: the S3 download sync has no --delete, so a stale
    # object from a prior snapshot would otherwise survive and be re-uploaded on a
    # later restore. Scoped to the four subdirs we write — never the whole $dir.
    rm -rf "${dir}/pg" "${dir}/s3" "${dir}/volumes" "${dir}/uc"
    mkdir -p "${dir}/pg" "${dir}/s3" "${dir}/volumes"

    local bucket uc db dbs="" vols="" v vn
    bucket=$(reset_effective_bucket)
    uc=$(detect_uc_backend)

    # PostgreSQL — every platform database (+ a PostgreSQL-backed UC DB, if any).
    for db in airflow iceberg_catalog mlflow; do dbs="${dbs} $(reset_effective_db "$db")"; done
    [ "${uc%%:*}" = postgresql ] && dbs="${dbs} $(reset_effective_db "${uc#postgresql:}")"
    for db in $dbs; do
        echo -e "${YELLOW}Dumping database ${db}...${NC}"
        pg_dump_db "$db" "${dir}/pg" || return 1
    done

    # S3 objects.
    echo -e "${YELLOW}Syncing s3://${bucket}/ ...${NC}"
    s3_sync download "$bucket" "${dir}/s3" || return 1

    # UC state via docker cp (only when the backend is embedded H2).
    if [ "$uc" = h2 ]; then
        echo -e "${YELLOW}Copying Unity Catalog H2 state...${NC}"
        uc_h2_backup "$dir" || return 1
    fi

    # Named volumes (absent ones skipped). Skip "never"-mode volumes: postgres-data
    # and seaweedfs-data hold the metastore/object store whose CONTENT is already
    # captured authoritatively above (pg_dump + s3_sync), and their services are NOT
    # quiesced (backup_writer_containers excludes them), so tarring their live data
    # dir would yield a torn archive and drive a corrupting volume_restore. Same guard
    # reset honors via reset_volume_mode (uc-logs is diagnostics, also skipped).
    for v in $(reset_discover_volumes); do
        [ "$(reset_volume_mode "$v")" = "never" ] && continue
        vn=$(reset_effective_volume "$v")
        echo -e "${YELLOW}Archiving volume ${vn}...${NC}"
        volume_backup "$vn" "${dir}/volumes" || return 1
        vols="${vols} ${vn}"
    done

    {
        echo "lakehouse-backup"
        echo "version=1"
        echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "overlay_active=${OVERLAY_ACTIVE:-false}"
        echo "run_id=${LAKEHOUSE_TEST_RUN_ID:-}"
        echo "bucket=${bucket}"
        echo "uc_backend=${uc}"
        echo "databases=${dbs# }"
        echo "volumes=${vols# }"
    } > "${dir}/MANIFEST"
    return 0
}

# ./lakehouse backup [--out <dir>] [--yes]
# Non-destructive: dumps every PostgreSQL DB, syncs S3, archives named volumes, and
# copies UC's H2 (T-1.5.5). Quiesces writers for a consistent snapshot, then ALWAYS
# restarts them — backup mutates nothing (I-52a, plan 1.16.5). Prints the artifact
# path and a ready-to-paste `restore --from` command (U-63).
cmd_backup() {
    local out=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --out)     [ $# -ge 2 ] || { echo "backup: --out requires a value" >&2; return 2; }; out="$2"; shift 2 ;;
            --yes|-y)  shift ;;  # accepted for symmetry; backup needs no confirmation
            *) echo "backup: unknown argument '$1'" >&2; return 2 ;;
        esac
    done
    header "BACKUP"

    # Overlay safety (same gate reset/restore run): backup quiesces containers and
    # snapshots the effective bucket/DBs. LAKEHOUSE_ENV_FILE is OPTIONAL under an
    # overlay (plan 1.16.1), so if it is unset the production .env is sourced and
    # S3_BUCKET / MLFLOW_PG_DB could resolve to PRODUCTION names — backup would then
    # quiesce test containers while snapshotting the real PG/S3. Abort unless every
    # effective target is run-scoped. Overlay-inactive: unrestricted (returns 0).
    reset_semantic_gate || return 1

    if [ -z "$out" ]; then
        local tag="" ts
        ts=$(date -u +%Y%m%dT%H%M%SZ)
        [ "${OVERLAY_ACTIVE:-false}" = true ] && tag="-${LAKEHOUSE_TEST_RUN_ID}"
        out="${PROJECT_ROOT}/backups/lakehouse-backup-${ts}${tag}"
    fi
    mkdir -p "$out"

    if ! backup_quiesce_writers; then
        backup_unquiesce_writers
        echo -e "${RED}Backup aborted:${NC} could not quiesce all writers — refusing to take a torn snapshot." >&2
        return 1
    fi
    local rc=0
    backup_take_snapshot "$out" || rc=$?
    backup_unquiesce_writers  # always — backup is non-mutating

    if [ "$rc" -ne 0 ]; then
        echo -e "${RED}Backup FAILED.${NC} Partial artifact left at: ${out}" >&2
        return 1
    fi
    echo -e "${GREEN}Backup complete:${NC} ${out}"
    echo "Restore it with:"
    echo "  ./lakehouse restore --from ${out}"
    return 0
}

restore_marker_path() { echo "$PROJECT_ROOT/.lakehouse-restore-interrupted"; }

# On a FAILED restore, leave services stopped and drop a marker with the exact
# rollback command (plan 1.15.4 / 1.17.8). doctor reports it in Checkpoint 5.
restore_write_marker() {
    local from="$1" snap="$2"
    cat > "$(restore_marker_path)" <<EOF
interrupted-restore
from=${from}
pre_restore_snapshot=${snap}
timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
overlay_active=${OVERLAY_ACTIVE:-false}
note=A restore failed mid-operation. Services were left STOPPED. Roll back with:
note=  ./lakehouse restore --from ${snap} --yes
EOF
    return 0
}

# Reject a restore whose MANIFEST targets don't match the CURRENT stack's effective
# targets, unless --force (review-handoff #2). Without this, the overlay-inactive
# (production) path applied whatever databases/bucket/volumes the MANIFEST named,
# letting a crafted or mistakenly-swapped artifact drive `pg_restore --create --clean`
# and `s3 sync --delete` at arbitrary names reachable with local creds. Matching the
# effective helpers also enforces run-scoping under an overlay (they yield run-scoped
# names there), so this subsumes the previous overlay-only MANIFEST check.
restore_validate_targets() {
    local dir="$1" force="$2"
    local m_bucket m_dbs m_vols
    m_bucket=$(grep '^bucket=' "${dir}/MANIFEST" | cut -d= -f2-)
    m_dbs=$(grep '^databases=' "${dir}/MANIFEST" | cut -d= -f2-)
    m_vols=$(grep '^volumes=' "${dir}/MANIFEST" | cut -d= -f2-)

    local exp_bucket exp_dbs="" exp_vols="" db v uc
    exp_bucket=$(reset_effective_bucket)
    for db in airflow iceberg_catalog mlflow; do exp_dbs="${exp_dbs} $(reset_effective_db "$db")"; done
    uc=$(detect_uc_backend)
    [ "${uc%%:*}" = postgresql ] && exp_dbs="${exp_dbs} $(reset_effective_db "${uc#postgresql:}")"
    for v in $(reset_discover_volumes); do exp_vols="${exp_vols} $(reset_effective_volume "$v")"; done

    local mismatch=""
    [ "$m_bucket" = "$exp_bucket" ] || mismatch="${mismatch} bucket(manifest='${m_bucket}',expected='${exp_bucket}')"
    for db in $m_dbs; do
        case " $exp_dbs " in *" $db "*) ;; *) mismatch="${mismatch} db('${db}')" ;; esac
    done
    for v in $m_vols; do
        case " $exp_vols " in *" $v "*) ;; *) mismatch="${mismatch} volume('${v}')" ;; esac
    done

    [ -z "$mismatch" ] && return 0
    if [ "$force" = true ]; then
        echo -e "  ${YELLOW}!${NC} restore: MANIFEST targets differ from the current stack; proceeding (--force):${mismatch}" >&2
        return 0
    fi
    echo -e "${RED}restore: MANIFEST targets do not match the current stack — refusing.${NC} Use --force to override. Offending:${mismatch}" >&2
    return 1
}

# Apply a backup from <dir> (fail-stop, no restart). ASSUMES a quiesced window.
# Recreates databases (owner/grants from the dump), syncs S3 with --delete, restores
# volumes, and reinstates UC's H2. Target-safety is enforced earlier by
# restore_validate_targets (MANIFEST must match the current stack's effective targets,
# which also yields run-scoping under an overlay); this function assumes that passed.
restore_apply() {
    local dir="$1"
    if [ ! -f "${dir}/MANIFEST" ]; then
        echo -e "${RED}restore: no MANIFEST in ${dir} — not a complete backup${NC}" >&2
        return 1
    fi
    local bucket dbs vols ucb
    bucket=$(grep '^bucket=' "${dir}/MANIFEST" | cut -d= -f2-)
    dbs=$(grep '^databases=' "${dir}/MANIFEST" | cut -d= -f2-)
    vols=$(grep '^volumes=' "${dir}/MANIFEST" | cut -d= -f2-)
    ucb=$(grep '^uc_backend=' "${dir}/MANIFEST" | cut -d= -f2-)

    local db v
    for db in $dbs; do
        echo -e "${YELLOW}Restoring database ${db}...${NC}"
        pg_restore_db "$db" "${dir}/pg" || return 1
    done

    echo -e "${YELLOW}Restoring objects into s3://${bucket}/ (sync --delete)...${NC}"
    aws_s3 mb "s3://${bucket}" >/dev/null 2>&1 || true  # ensure the bucket exists first
    s3_sync upload "$bucket" "${dir}/s3" || return 1

    # Defense against a pre-fix manifest that still lists a "never"-mode storage
    # volume: never rm -rf + tar-restore postgres-data/seaweedfs-data under the live
    # store — their content is restored via pg_restore + s3_sync above. The manifest
    # stores EFFECTIVE (project-prefixed) names, so compare against the effective names
    # of the never-mode volumes rather than the base names reset_volume_mode keys on.
    local never_vols="" nv
    for nv in $(reset_discover_volumes); do
        [ "$(reset_volume_mode "$nv")" = "never" ] && never_vols="${never_vols} $(reset_effective_volume "$nv")"
    done
    for v in $vols; do
        case " ${never_vols} " in
            *" ${v} "*)
                echo -e "${YELLOW}Skipping volume ${v} (restored via pg_restore + s3 sync)${NC}"
                continue ;;
        esac
        echo -e "${YELLOW}Restoring volume ${v}...${NC}"
        volume_restore "$v" "${dir}/volumes/${v}.tar" || return 1
    done

    if [ "$ucb" = h2 ] && [ -f "${dir}/uc/h2db.mv.db" ]; then
        echo -e "${YELLOW}Restoring Unity Catalog H2 state...${NC}"
        uc_h2_restore "$dir" || return 1
    fi
    return 0
}

# ./lakehouse restore --from <path> [--yes] [--force]
# FAIL-STOP and RECOVERABLE, not atomic (plan 1.15.4). Inside a SINGLE quiesced
# window (plan 1.16.9): quiesce -> pre-restore snapshot (same snapshot path, no
# restart) -> mutate. On failure: leave services stopped, preserve a marker, print
# the rollback command. On success: clear the marker and restart the prior set.
cmd_restore() {
    local from="" assume_yes=false force=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --from)    [ $# -ge 2 ] || { echo "restore: --from requires a value" >&2; return 2; }; from="$2"; shift 2 ;;
            --yes|-y)  assume_yes=true; shift ;;
            --force)   force=true; shift ;;
            *) echo "restore: unknown argument '$1'" >&2; return 2 ;;
        esac
    done

    if [ -z "$from" ]; then
        echo "restore: --from <path> is required" >&2
        return 2
    fi
    if [ ! -d "$from" ] || [ ! -f "${from}/MANIFEST" ]; then
        echo "restore: '${from}' is not a complete backup artifact (missing MANIFEST)" >&2
        return 2
    fi
    header "RESTORE"

    if [ "$assume_yes" != true ]; then
        if [ -t 0 ]; then
            echo -e "${RED}This REPLACES databases, object storage (sync --delete), and volumes from ${from}.${NC} Type 'yes' to proceed:"
            local reply
            read -r reply
            [ "$reply" = yes ] || { echo "Aborted."; return 1; }
        else
            echo "restore: refusing a destructive restore without --yes (non-interactive)" >&2
            return 1
        fi
    fi

    reset_semantic_gate || return 1

    # Reject a MANIFEST whose targets are not this stack's (review-handoff #2) BEFORE
    # touching any service; --force overrides.
    restore_validate_targets "$from" "$force" || return 1

    if ! backup_quiesce_writers; then
        backup_unquiesce_writers
        echo -e "${RED}Restore aborted:${NC} could not quiesce all writers — refusing to mutate with a live writer." >&2
        return 1
    fi

    local ts snap
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    snap="${PROJECT_ROOT}/backups/pre-restore-${ts}"
    mkdir -p "$snap"
    echo -e "${YELLOW}Taking pre-restore snapshot at ${snap}...${NC}"
    if ! backup_take_snapshot "$snap"; then
        # Failed BEFORE any mutation — safe to restart and abort with nothing changed.
        backup_unquiesce_writers
        echo -e "${RED}restore: pre-restore snapshot failed; nothing was changed.${NC}" >&2
        return 1
    fi

    if ! restore_apply "$from"; then
        restore_write_marker "$from" "$snap"
        echo -e "${RED}Restore FAILED mid-operation.${NC} Services left STOPPED to avoid compounding corruption." >&2
        echo -e "  Pre-restore snapshot: ${snap}" >&2
        echo -e "  Roll back with: ./lakehouse restore --from ${snap} --yes" >&2
        echo -e "  Marker: $(restore_marker_path)" >&2
        return 1
    fi

    rm -f "$(restore_marker_path)" 2>/dev/null || true
    backup_unquiesce_writers
    echo -e "${GREEN}Restore complete from ${from}.${NC}"
    echo -e "  Pre-restore snapshot kept at: ${snap}"
    return 0
}

# --- doctor: orphan / inconsistency detector (Checkpoint 5, T-1.5.6) --------------
#
# doctor is READ-ONLY. It gathers a normalized inventory from S3 + Unity Catalog +
# the MLflow database, then a PURE classifier (doctor_classify) maps it to FOUR
# orphan classes (plan 1.19.1) — never a single aggregate count:
#   recoverable-delta       Delta prefix with objects but no UC registration
#   doubtful-iceberg        Iceberg prefix with no UC registration (UC OSS 0.4.x has
#                           no Iceberg write endpoints, so re-registration may fail)
#   unrecoverable-mlflow    mlflow-artifacts/ bytes whose run record is gone
#   dangling-catalog-entry  UC row with empty/null location OR a valid URI resolving
#                           to zero objects (plan 1.16.8)
# The INVERSE MLflow direction (run record -> missing bytes) is undecidable without a
# durable artifact manifest and is OMITTED (plan 1.19.1); a healthy artifact-free run
# is therefore never flagged (U-62).

# Pure classifier. Reads normalized inventory lines on stdin, emits one
# "DOCTOR class=<c> name=<n>" per orphan. Distinct, Docker-free code path (U-34).
# Line grammar (space-separated key=val, name= MUST be last so a value may contain
# anything except a literal " name="):
#   prefix   type=<delta|iceberg> registered=<yes|no> name=<loc>
#   artifact run_known=<yes|no> name=<key>
#   uc-row   objects=<N|NA> location_empty=<yes|no> name=<full>
doctor_classify() {
    local line kind meta name
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        kind="${line%% *}"
        # Classify ONLY the metadata tokens, never the trailing name= value: an S3
        # path may itself contain a segment like "type=iceberg" or "registered=yes",
        # which would otherwise be misread as a token. name= is guaranteed last.
        meta="${line%% name=*}"
        name="${line#*name=}"
        case "$kind" in
            prefix)
                case " $meta " in
                    *" registered=yes "*) : ;;  # registered -> healthy, not an orphan
                    *"type=delta"*)   echo "DOCTOR class=recoverable-delta name=${name}" ;;
                    *"type=iceberg"*) echo "DOCTOR class=doubtful-iceberg name=${name}" ;;
                esac
                ;;
            artifact)
                case " $meta " in
                    *" run_known=no "*) echo "DOCTOR class=unrecoverable-mlflow name=${name}" ;;
                esac
                ;;
            uc-row)
                case " $meta " in
                    *" location_empty=yes "*) echo "DOCTOR class=dangling-catalog-entry name=${name}" ;;
                    *" objects=0 "*)          echo "DOCTOR class=dangling-catalog-entry name=${name}" ;;
                esac
                ;;
        esac
    done
    return 0
}

# All UC table rows as TSV "<catalog.schema.table>\t<storage_location>". Reached via
# the resolved UC container's netns (same transport as reset_clear_uc_registrations)
# so it targets the run-scoped UC under an overlay and production UC otherwise. Empty
# when UC is not running.
doctor_uc_rows() {
    local uc img
    uc=$(resolve_container_name unity-catalog)
    is_container_running "$uc" || return 0
    img="${LAKEHOUSE_HTTP_IMAGE:-python:3-alpine}"
    docker run -i --rm --network "container:${uc}" --entrypoint python3 "$img" - <<'PY' 2>/dev/null || true
import json, urllib.request
api = "http://localhost:8080/api/2.1/unity-catalog"
def get(path):
    try:
        with urllib.request.urlopen(api + path, timeout=10) as x:
            return json.load(x)
    except Exception:
        return {}
def pages(path, key):
    # Follow next_page_token so doctor sees ALL rows, not just page 1 (else it would
    # under-report dangling entries and mis-flag healthy prefixes as unregistered).
    sep = "&" if "?" in path else "?"
    token = None
    while True:
        p = path if token is None else f"{path}{sep}page_token={token}"
        d = get(p)
        for item in d.get(key, []):
            yield item
        token = d.get("next_page_token")
        if not token:
            break
for cat in pages("/catalogs", "catalogs"):
    c = cat["name"]
    for sch in pages(f"/schemas?catalog_name={c}", "schemas"):
        s = sch["name"]
        for t in pages(f"/tables?catalog_name={c}&schema_name={s}", "tables"):
            loc = (t.get("storage_location") or "").rstrip("/")
            print(f"{c}.{s}.{t['name']}\t{loc}")
PY
}

# Normalized S3 warehouse inventory: one "prefix" line per Delta/Iceberg table prefix
# under warehouse/, tagged registered=yes|no by cross-referencing UC's storage
# locations. A Delta prefix contains _delta_log/; an Iceberg prefix contains
# metadata/*.metadata.json.
doctor_inventory_s3_warehouse() {
    local bucket reg keys
    bucket=$(reset_effective_bucket)
    reg="$(doctor_uc_rows | cut -f2 | grep -v '^$' || true)"
    keys="$(aws_s3 ls "s3://${bucket}/warehouse/" --recursive 2>/dev/null | awk '{$1=$2=$3=""; sub(/^[[:space:]]+/,""); print}' || true)"

    printf '%s\n' "$keys" | grep '/_delta_log/' 2>/dev/null \
        | sed -E 's#/_delta_log/.*$##' | sort -u | while read -r p; do
        [ -n "$p" ] || continue
        loc="s3://${bucket}/${p}"
        if printf '%s\n' "$reg" | grep -qxF "$loc"; then
            echo "prefix type=delta registered=yes name=${loc}"
        else
            echo "prefix type=delta registered=no name=${loc}"
        fi
    done

    printf '%s\n' "$keys" | grep -E '/metadata/[^/]*\.metadata\.json$' 2>/dev/null \
        | sed -E 's#/metadata/[^/]*$##' | sort -u | while read -r p; do
        [ -n "$p" ] || continue
        loc="s3://${bucket}/${p}"
        if printf '%s\n' "$reg" | grep -qxF "$loc"; then
            echo "prefix type=iceberg registered=yes name=${loc}"
        else
            echo "prefix type=iceberg registered=no name=${loc}"
        fi
    done
    return 0
}

# Normalized MLflow inventory: one "artifact" line per per-run artifact object, tagged
# run_known=yes|no by cross-referencing the run id (the 32-hex path segment) against
# the mlflow runs table. Keys without a run-id segment are ambiguous and skipped (no
# false positives). Skipped entirely when the runs table is absent (MLflow not set
# up -> nothing decidable, plan 1.19.1).
doctor_inventory_mlflow() {
    local bucket db known keys run
    bucket=$(reset_effective_bucket)
    db=$(reset_effective_db mlflow)
    if [ -z "$(pg_psql -d "$db" -tAc "SELECT to_regclass('runs')" 2>/dev/null | tr -d '[:space:]')" ]; then
        return 0
    fi
    known="$(pg_psql -d "$db" -tAc 'SELECT run_uuid FROM runs' 2>/dev/null | tr -d '\r' || true)"
    keys="$(aws_s3 ls "s3://${bucket}/mlflow-artifacts/" --recursive 2>/dev/null | awk '{$1=$2=$3=""; sub(/^[[:space:]]+/,""); print}' || true)"
    printf '%s\n' "$keys" | while read -r k; do
        [ -n "$k" ] || continue
        run="$(printf '%s\n' "$k" | tr '/' '\n' | grep -iE '^[0-9a-f]{32}$' | head -1)"
        [ -n "$run" ] || continue
        if printf '%s\n' "$known" | grep -qxF "$run"; then
            echo "artifact run_known=yes name=s3://${bucket}/${k}"
        else
            echo "artifact run_known=no name=s3://${bucket}/${k}"
        fi
    done
    return 0
}

# Normalized UC inventory: one "uc-row" line per registered table, tagging the
# dangling inputs — empty/null storage_location, or a valid URI whose prefix has zero
# objects (plan 1.16.8).
doctor_inventory_uc() {
    local name loc n
    # If S3 is unreachable we cannot tell an empty prefix (rc=1, no output) from a
    # listing failure, so a naive count would report objects=0 and flag EVERY healthy
    # table as dangling. Probe the bucket root once (rc=0 iff reachable, even empty);
    # when it fails, emit objects=unknown — which doctor_classify never flags.
    local s3_ok=1
    aws_s3 ls "s3://$(reset_effective_bucket)/" >/dev/null 2>&1 || s3_ok=0
    while IFS=$'\t' read -r name loc; do
        [ -n "$name" ] || continue
        if [ -z "$loc" ]; then
            echo "uc-row objects=NA location_empty=yes name=${name}"
            continue
        fi
        if [ "$s3_ok" -ne 1 ]; then
            echo "uc-row objects=unknown location_empty=no name=${name}"
            continue
        fi
        n="$(aws_s3 ls "${loc}/" --recursive 2>/dev/null | grep -c . || true)"
        echo "uc-row objects=${n:-0} location_empty=no name=${name}"
    done < <(doctor_uc_rows)
    return 0
}

doctor_gather_inventory() {
    doctor_inventory_s3_warehouse
    doctor_inventory_mlflow
    doctor_inventory_uc
    return 0
}

# Print one class section (skipped when empty). Never a single aggregate count
# (T-1.5.6): each class is reported separately with its own items.
doctor_report_class() {
    local findings="$1" cls="$2" desc="$3" items n
    items="$(printf '%s\n' "$findings" | grep "class=${cls} " | sed "s/^DOCTOR class=${cls} name=/  - /" || true)"
    n=$(printf '%s\n' "$items" | grep -c '^  - ' || true)
    [ "$n" -eq 0 ] && return 0
    echo -e "${YELLOW}[${cls}]${NC} ${desc} — ${n}:"
    printf '%s\n' "$items"
    return 0
}

# ./lakehouse doctor — report orphaned data / catalog inconsistencies + any
# interrupted reset/restore markers. Read-only; exits 0 (advisory).
cmd_doctor() {
    header "DOCTOR"
    local had=false

    if [ -f "$(reset_marker_path)" ]; then
        had=true
        echo -e "${RED}! interrupted reset detected${NC} — a destructive reset did not complete:"
        sed 's/^/    /' "$(reset_marker_path)"
        echo ""
    fi
    if [ -f "$(restore_marker_path)" ]; then
        had=true
        echo -e "${RED}! interrupted restore detected${NC} — a restore did not complete:"
        sed 's/^/    /' "$(restore_marker_path)"
        echo ""
    fi

    local findings
    findings="$(doctor_gather_inventory | doctor_classify)"
    if [ -n "$findings" ]; then had=true; fi

    doctor_report_class "$findings" recoverable-delta \
        "recoverable Delta prefixes (objects present, no UC registration — re-registerable from the Delta log)"
    doctor_report_class "$findings" doubtful-iceberg \
        "doubtful Iceberg prefixes (UC OSS 0.4.x exposes no Iceberg write endpoints — re-registration may be impossible)"
    doctor_report_class "$findings" unrecoverable-mlflow \
        "UNRECOVERABLE MLflow artifacts (bytes whose run record is gone)"
    doctor_report_class "$findings" dangling-catalog-entry \
        "dangling catalog entries (UC row with empty location or a URI resolving to zero objects)"

    if [ "$had" = false ]; then
        echo -e "${GREEN}No orphans or inconsistencies detected.${NC}"
    fi
    return 0
}

# Help
# Hidden introspection command for the test harness (plan T-1.5.0c). Prints the
# effective resolution — overlay state, resolved container names, resolved published
# ports, and per-base compose-file argument sets — without touching any service.
# When the overlay is active it also validates that every needed overlay file exists
# and renders (plan 1.17.2), aborting non-zero otherwise (proves U-60).
cmd_resolve() {
    echo "overlay_active=${OVERLAY_ACTIVE:-false}"
    if [ "${OVERLAY_ACTIVE:-false}" = "true" ]; then
        echo "run_id=${LAKEHOUSE_TEST_RUN_ID}"
        echo "compose_project=${COMPOSE_PROJECT_NAME:-}"
        overlay_validate_all_services || exit 1
    fi

    local c
    for c in spark-master-41 spark-worker-41 spark-connect-41 kafka zookeeper \
             unity-catalog airflow-webserver airflow-scheduler airflow-triggerer \
             mlflow jupyter; do
        echo "container.${c}=$(resolve_container_name "$c")"
    done

    # Port arithmetic (base [+ offset]) for reference only. NOTE: the shipped test
    # overlays use bridge networking and publish NO host ports (plan 1.17.1) — a
    # test that needs host reachability publishes its own port at this offset. So
    # these values are the resolver's arithmetic, not live connection targets, and
    # runtime health probes deliberately use the fixed base ports.
    echo "ports_published_by_overlays=none"
    # PostgreSQL and SeaweedFS are Composed (PR #13) but have NO test overlay, so
    # they always publish fixed ports and are never offset. Only overlaid services
    # take a port offset.
    echo "port.postgresql=5432"
    echo "port.seaweedfs=8333"
    echo "port.unity_catalog=$(resolve_port 8081)"
    echo "port.spark_connect=$(resolve_port 15002)"
    echo "port.spark_ui=$(resolve_port 8082)"
    echo "port.spark_worker_ui=$(resolve_port 8083)"
    echo "port.kafka=$(resolve_port 9092)"
    echo "port.zookeeper=$(resolve_port 2181)"
    echo "port.airflow=$(resolve_port 8085)"
    echo "port.mlflow=$(resolve_port 5000)"

    local svc
    for svc in spark41 kafka unity-catalog airflow mlflow notebooks; do
        overlay_set_compose_args "$svc" || exit 1
        echo "compose.${svc}=${OVERLAY_COMPOSE_ARGS[*]}"
    done
}

