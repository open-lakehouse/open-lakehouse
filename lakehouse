# Main
parse_flags "$@"
export_spark_env

# Re-bind positional args to the flag-stripped list so `case $1` sees the command.
set -- "${ARGS[@]}"

# Overlay activation is ALL-OR-NOTHING (plan 1.17.2): if ANY LAKEHOUSE_* overlay
# variable is set, all must be present and valid or we abort non-zero — the CLI must
# never fall back to the real stack. A no-op (returns 0) when no overlay var is set.
if ! overlay_validate_activation; then
    exit 1
fi

# Let `help` and `status` bypass the local-mode guard so users can inspect state
# without committing to a transport. All other commands enforce connect-only.
case ${1:-help} in
    help|status|__resolve|reset|backup|restore|doctor|''|-h|--help) ;;
    *) require_connect_mode ;;
esac

case ${1:-help} in
    setup)        cmd_setup ;;
    check-config) cmd_check_config ;;
    preflight)    cmd_preflight ;;
    migrate)      cmd_migrate "${@:2}" ;;
    status)       cmd_status ;;
    start)        cmd_start "${2:-all}" ;;
    stop)         cmd_stop "${2:-all}" ;;
    restart)
        cmd_stop "${2:-all}"
        sleep 2
        cmd_start "${2:-all}"
        ;;
    logs)         cmd_logs "$2" ;;
    test)         cmd_test ;;
    producer)     cmd_producer ;;
    consumer)     cmd_consumer ;;
    testdata)     cmd_testdata "${@:2}" ;;
    browsedata)   browse_tables "$2" ;;
    reset)        cmd_reset "${@:2}" ;;
    backup)       cmd_backup "${@:2}" ;;
    restore)      cmd_restore "${@:2}" ;;
    doctor)       cmd_doctor "${@:2}" ;;
    __resolve)    cmd_resolve ;;
    help|*)       cmd_help ;;
esac
