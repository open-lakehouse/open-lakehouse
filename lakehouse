}

# Test command
cmd_test() {
    set +e  # Disable exit on error for tests
    header "RUNNING TESTS"
    # Resolve container names through the overlay layer (base names on the default
    # path; run-scoped under an active test overlay) so `test` never probes/execs
    # the wrong stack (plan 1.17.4).
    local master_container kafka_ctr uc_ctr aflow_web_ctr aflow_sched_ctr connect_ctr
    master_container=$(resolve_container_name "$(get_spark_master_container)")
    kafka_ctr=$(resolve_container_name kafka)
    uc_ctr=$(resolve_container_name unity-catalog)
    aflow_web_ctr=$(resolve_container_name airflow-webserver)
    aflow_sched_ctr=$(resolve_container_name airflow-scheduler)
    connect_ctr=$(resolve_container_name spark-connect-41)
    local failures=0

    echo -e "${YELLOW}1. Testing PostgreSQL connection...${NC}"
    # Use pg_psql (host client if present, else the version-matched dockerized
    # client) so the check works against the Composed PostgreSQL without a host
    # psql install (PR #13).
    if pg_psql -d iceberg_catalog -c "SELECT 1;" >/dev/null 2>&1; then
        echo -e "   ${GREEN}✓${NC} PostgreSQL connected"
    else
        echo -e "   ${RED}✗${NC} PostgreSQL failed"
        echo -e "   ${YELLOW}→ Check that storage is running: ./lakehouse start storage${NC}"
        echo -e "   ${YELLOW}→ Verify POSTGRES_USER/PASSWORD in .env match the postgres service${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}2. Testing SeaweedFS (S3)...${NC}"
    if curl -s --connect-timeout 5 http://localhost:8333 > /dev/null 2>&1; then
        echo -e "   ${GREEN}✓${NC} SeaweedFS responding"
    else
        echo -e "   ${RED}✗${NC} SeaweedFS not responding on port 8333"
        echo -e "   ${YELLOW}→ Check if SeaweedFS is running${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}2b. Testing S3 conformance + presigned host-rewrite + layout (PR #13/Phase 2)...${NC}"
    # These run on the host against localhost:8333 and need boto3 + requests
    # (poetry deps). Skip with a hint if the runner/deps are unavailable rather
    # than hard-failing the whole suite on a machine that hasn't run setup.
    if poetry run python -c "import boto3, requests" >/dev/null 2>&1; then
        for s3test in test-s3-conformance test-presigned-host-rewrite test-warehouse-layout; do
            if poetry run python "scripts/connectivity/${s3test}.py"; then
                echo -e "   ${GREEN}✓${NC} ${s3test} passed"
            else
                echo -e "   ${RED}✗${NC} ${s3test} failed"
                ((failures++))
            fi
        done
    else
        echo -e "   ${YELLOW}-${NC} boto3/requests unavailable — skipping S3 conformance"
        echo -e "   ${YELLOW}→ Run: ./lakehouse setup (or poetry install)${NC}"
    fi

    echo -e "\n${YELLOW}3. Testing Kafka...${NC}"
    if docker ps --format '{{.Names}}' | grep -q "^${kafka_ctr}$"; then
        if docker exec "$kafka_ctr" kafka-topics --list --bootstrap-server localhost:9092 >/dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} Kafka broker healthy"
        else
            echo -e "   ${RED}✗${NC} Kafka broker not responding"
            echo -e "   ${YELLOW}→ Check: docker logs ${kafka_ctr}${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${RED}✗${NC} Kafka container not running"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start kafka${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}4. Testing Spark 4.1...${NC}"
    if docker ps --format '{{.Names}}' | grep -q "^${master_container}$"; then
        if docker exec "$master_container" /opt/spark/bin/spark-submit --version >/dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} Spark master healthy ($master_container)"
        else
            echo -e "   ${RED}✗${NC} Spark not responding"
            echo -e "   ${YELLOW}→ Check: docker logs $master_container${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${RED}✗${NC} Spark container not running ($master_container)"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start spark${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}4b. Testing Spark Connect gRPC...${NC}"
    if nc -z localhost "$(get_spark_connect_port)" 2>/dev/null; then
        echo -e "   ${GREEN}✓${NC} Spark Connect listening on $(get_spark_remote)"
    else
        echo -e "   ${RED}✗${NC} Spark Connect not reachable on port $(get_spark_connect_port)"
        echo -e "   ${YELLOW}→ Check: docker logs ${connect_ctr}${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}5. Testing Unity Catalog (optional)...${NC}"
    if docker ps --format '{{.Names}}' | grep -q "^${uc_ctr}$"; then
        if curl -s --connect-timeout 5 http://localhost:8081/api/2.1/unity-catalog/catalogs > /dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} Unity Catalog REST API healthy"
            # Test Iceberg REST endpoint
            if curl -s --connect-timeout 5 http://localhost:8081/api/2.1/unity-catalog/iceberg/v1/config > /dev/null 2>&1; then
                echo -e "   ${GREEN}✓${NC} Iceberg REST Catalog endpoint available"
            else
                echo -e "   ${YELLOW}!${NC} Iceberg REST endpoint not responding (may need configuration)"
            fi
        else
            echo -e "   ${RED}✗${NC} Unity Catalog not responding"
            echo -e "   ${YELLOW}→ Check: docker logs ${uc_ctr}${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${YELLOW}-${NC} Unity Catalog not running (optional)"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start unity-catalog${NC}"
    fi

    echo -e "\n${YELLOW}6. Testing Airflow (optional)...${NC}"
    if docker ps --format '{{.Names}}' | grep -q "^${aflow_web_ctr}$"; then
        if curl -s --connect-timeout 5 http://localhost:8085/health | grep -q '"healthy"'; then
            echo -e "   ${GREEN}✓${NC} Airflow webserver healthy"
            if docker ps --format '{{.Names}}' | grep -q "^${aflow_sched_ctr}$"; then
                echo -e "   ${GREEN}✓${NC} Airflow scheduler running"
            else
                echo -e "   ${RED}✗${NC} Airflow scheduler not running"
                ((failures++))
            fi
        else
            echo -e "   ${RED}✗${NC} Airflow webserver not responding"
            echo -e "   ${YELLOW}→ Check: docker logs ${aflow_web_ctr}${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${YELLOW}-${NC} Airflow not running (optional)"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start airflow${NC}"
    fi

    # Summary
    set -e  # Re-enable exit on error
    echo -e "\n${BLUE}================================${NC}"
    if [ $failures -eq 0 ]; then
        echo -e "${GREEN}All tests passed!${NC}"
        return 0
    else
        echo -e "${RED}$failures test(s) failed${NC}"
        echo -e "Run ${YELLOW}./lakehouse setup${NC} to diagnose issues"
        return 1
    fi
}

