# Testdata commands
cmd_testdata() {
    local subcmd=$1
    shift

    case $subcmd in
        generate)
            header "GENERATING TEST DATA"
            poetry run python -m scripts.testdata generate "$@"
            ;;
        stream)
            header "STREAMING TO KAFKA"
            poetry run python -m scripts.testdata stream "$@"
            ;;
        load)
            header "LOADING TO ICEBERG"
            local master_container
            master_container=$(resolve_container_name "$(get_spark_master_container)")
            if [ -f "data/load_to_iceberg.py" ]; then
                # Copy load script to scripts dir (which is mounted in container)
                cp data/load_to_iceberg.py scripts/_load_to_iceberg.py
                docker exec "$master_container" /opt/spark/bin/spark-submit \
                    /scripts/_load_to_iceberg.py
                rm -f scripts/_load_to_iceberg.py
            else
                echo -e "${RED}No load script found. Run 'lakehouse testdata generate' first.${NC}"
                exit 1
            fi
            ;;
        stats)
            header "TEST DATA STATISTICS"
            poetry run python -m scripts.testdata stats "$@"
            ;;
        clean)
            header "CLEANING TEST DATA"
            poetry run python -m scripts.testdata clean "$@"
            ;;
        *)
            echo "Usage: lakehouse testdata <command> [options]"
            echo ""
            echo "Commands:"
            echo "  generate [--days N] [--seed N]    Generate test dataset"
            echo "  stream [--speed N]                Stream events to Kafka"
            echo "  load                              Load data into Iceberg tables"
            echo "  stats                             Show dataset statistics"
            echo "  clean                             Remove generated data"
            echo ""
            echo "Examples:"
            echo "  lakehouse testdata generate --days 90"
            echo "  lakehouse testdata stream --speed 60"
            echo "  lakehouse testdata load"
            exit 1
            ;;
    esac
}

# Check-config command - validates credential consistency
cmd_check_config() {
    header "CONFIGURATION CHECK"

    echo -e "\n${YELLOW}1. Checking .env file...${NC}"
    if [ -f "$PROJECT_ROOT/.env" ]; then
        source "$PROJECT_ROOT/.env"
        local env_issues=0

        [ -z "$POSTGRES_USER" ] && echo -e "   ${RED}✗${NC} POSTGRES_USER not set" && env_issues=1
        [ -z "$POSTGRES_PASSWORD" ] && echo -e "   ${RED}✗${NC} POSTGRES_PASSWORD not set" && env_issues=1
        [ -z "$S3_ACCESS_KEY" ] && echo -e "   ${RED}✗${NC} S3_ACCESS_KEY not set" && env_issues=1
        [ -z "$S3_SECRET_KEY" ] && echo -e "   ${RED}✗${NC} S3_SECRET_KEY not set" && env_issues=1
        [ "$POSTGRES_USER" = "your_username" ] && echo -e "   ${YELLOW}!${NC} POSTGRES_USER has placeholder value" && env_issues=1
        [ "$S3_ACCESS_KEY" = "your_access_key_here" ] && echo -e "   ${YELLOW}!${NC} S3_ACCESS_KEY has placeholder value" && env_issues=1

        [ $env_issues -eq 0 ] && echo -e "   ${GREEN}✓${NC} .env configuration valid"
    else
        echo -e "   ${RED}✗${NC} .env file not found"
    fi

    echo -e "\n${YELLOW}2. Checking spark-defaults.conf...${NC}"
    check_credential_consistency

    echo -e "\n${YELLOW}3. Testing database connection...${NC}"
    local pg_user="${POSTGRES_USER:-postgres}"
    local pg_pass="${POSTGRES_PASSWORD:-}"
    local pg_host="${POSTGRES_HOST:-localhost}"
    pg_host="${pg_host/host.docker.internal/localhost}"

    if PGPASSWORD="$pg_pass" psql -h "$pg_host" -U "$pg_user" -d iceberg_catalog -c "SELECT 1;" >/dev/null 2>&1; then
        echo -e "   ${GREEN}✓${NC} PostgreSQL connection successful"
    else
        echo -e "   ${RED}✗${NC} PostgreSQL connection failed"
        echo -e "   ${YELLOW}→ Check credentials and ensure database exists${NC}"
    fi

    echo -e "\n${YELLOW}4. Testing S3 endpoint...${NC}"
    local s3_endpoint="${S3_ENDPOINT:-http://localhost:8333}"
    s3_endpoint="${s3_endpoint/host.docker.internal/localhost}"

    if curl -s --connect-timeout 5 "$s3_endpoint" > /dev/null 2>&1; then
        echo -e "   ${GREEN}✓${NC} S3 endpoint responding"
    else
        echo -e "   ${YELLOW}!${NC} S3 endpoint not responding (may be OK if SeaweedFS not started)"
    fi
}

