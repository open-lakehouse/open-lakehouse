# PostgreSQL
POSTGRES_USER=your_username
# ./lakehouse setup generates private local credentials and service configs.
# Existing installations retain their configured values; never rotate keys blindly.
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SeaweedFS S3
# Legacy demo defaults below are replaced with random keys on a fresh setup.
# Configured credentials are preserved for existing installations.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=lakehouse_s3
S3_SECRET_KEY=lakehouse_s3_secret
S3_BUCKET=lakehouse
S3_WAREHOUSE=s3a://lakehouse/warehouse

# Iceberg
ICEBERG_WAREHOUSE=${S3_WAREHOUSE}

# Airflow (optional - only needed if using ./lakehouse start airflow)
# Setup replaces these placeholders with generated local credentials.
AIRFLOW_ADMIN_USER=your_airflow_user
AIRFLOW_ADMIN_PASSWORD=your_secure_password_here
# Generate Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Jupyter (optional - only needed if using ./lakehouse start notebooks)
# Token required to open the Lab UI (http://localhost:8889/?token=...). Empty is
# rejected — set a real value. Generate one with: openssl rand -hex 32
JUPYTER_TOKEN=change_me_generate_a_real_token

# Optional: build images behind a package proxy (default is public PyPI).
# Uncomment in your .env to build airflow/notebooks through the proxy (Compose
# reads these at build time), or pass them inline for a single build. Your .env
# is gitignored — but never put a real internal proxy URL anywhere committed.
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_TRUSTED_HOST=

# MLflow metadata database and Delta Sharing (setup generates missing secrets).
# MLFLOW_PG_PASS=
# DELTA_SHARING_TOKEN=
